    container PON_ONU_STATISTICS_ACCUMULATING_ONU_FEC_PM {
      description
        "PON_ONU_STATISTICS_ACCUMULATING_ONU_FEC_PM table in CounterDB.";
      config false;
      list PON_ONU_STATISTICS_ACCUMULATING_ONU_FEC_PM_LIST {
        key "onu-name onu-id";
        description
          "GPON: FEC statistics reported by ONU through OMCI.
           CounterDB key: PON_ONU_STATISTICS_ACCUMULATING_ONU_FEC_PM|<onu-name>|<onu-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf onu-id {
          type uint16;
          description
            "Performance management ME ID.";
        }
        leaf corrected-bytes {
          type uint64;
          description
            "corrected bytes";
        }
        leaf corrected-code-words {
          type uint64;
          description
            "corrected code words";
        }
        leaf fec-seconds {
          type uint64;
          description
            "fec seconds";
        }
        leaf interval-end-time {
          type uint64;
          description
            "interval end time";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "threshold data 1/2 id";
        }
        leaf total-code-words {
          type uint64;
          description
            "total code words";
        }
        leaf uncorrectable-code-words {
          type uint64;
          description
            "uncorrectable code words";
        }
      }
    }
    container PON_ONU_STATISTICS_ACCUMULATING_ONU_ENHANCED_TC_PM {
      description
        "PON_ONU_STATISTICS_ACCUMULATING_ONU_ENHANCED_TC_PM table in CounterDB.";
      config false;
      list PON_ONU_STATISTICS_ACCUMULATING_ONU_ENHANCED_TC_PM_LIST {
        key "onu-name onu-id";
        description
          "GPON: Enhanced TC statistics reported by ONU.
           CounterDB key: PON_ONU_STATISTICS_ACCUMULATING_ONU_ENHANCED_TC_PM|<onu-name>|<onu-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf onu-id {
          type uint16;
          description
            "ME Identifier for this TC.";
        }
        leaf lods-event-count {
          type uint64;
          description
            "Counts the number of state transitions from O5.1 to O6";
        }
        leaf lods-event-restored-count {
          type uint64;
          description
            "Counts the number of LODS cleared events";
        }
        leaf fragment-xgem-frames {
          type uint64;
          description
            "Counts the number of XGEM frames that represent fragmented SDUs, as indicated by the LF bit = 0";
        }
        leaf interval-end-time {
          type uint64;
          description
            "Identifies the most recently finished 15 min interval";
        }
        leaf onu-reactivation-by-lods-events {
          type uint64;
          description
            "Counts the number of LODS events resulting in ONU reactivation without synchronization being reacquired";
        }
        leaf psbd-hec-error-count {
          type uint64;
          description
            "Counts HEC errors in any of the fields of the downstream physical sync block";
        }
        leaf received-bytes-in-nonidle-xgem-frames {
          type uint64;
          description
            "Counts the number of received bytes in non-idle XGEM frames";
        }
        leaf transmitted-bytes-in-nonidle-xgem-frames {
          type uint64;
          description
            "Counts the number of transmitted bytes in non-idle XGEM frames";
        }
        leaf transmitted-xgem-frames {
          type uint64;
          description
            "Counts the number of non-idle XGEM frames transmitted. If an SDU is fragmented, each fragment is an XGEM frame and is counted as such.";
        }
        leaf unknown-profile-count {
          type uint64;
          description
            "Counts the number of grants received whose specified profile was not known to the ONU";
        }
        leaf xgem-hec-lost-words-count {
          type uint64;
          description
            "Counts the number of 4 byte words lost because of an XGEM frame HEC error. In general, all XGTC
             payload following the error is lost, until the next PSBd event.
            ";
        }
        leaf xgem-key-errors {
          type uint64;
          description
            "Counts the number of downstream XGEM frames received with an invalid key specification";
        }
        leaf xgem-hec-error-count {
          type uint64;
          description
            "Counts the number of instances of an XGEM frame HEC error";
        }
        leaf xgtc-hec-error-count {
          type uint64;
          description
            "Counts HEC errors detected in the XGTC header";
        }
        leaf threshold-data-64-bit-id {
          type uint64;
          description
            "Points to an instance of the threshold data 1 ME that contains PM threshold values";
        }
