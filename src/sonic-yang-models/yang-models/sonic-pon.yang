    container PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_PERF_MON_HIST_DATA_DOWNSTREAM {
      description
        "Ethernet frame performance monitoring history data downstream, Class Value 321. This ME is identical to the Ethernet frame PM history data upstream ME, with the exception that it monitors downstream traffic. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_PERF_MON_HIST_DATA_DOWNSTREAM.";
      reference
        "G.988, 9.3.31, Ethernet frame performance monitoring history data downstream";
      list PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_PERF_MON_HIST_DATA_DOWNSTREAM_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_ETHERNET_FRAME_PERF_MON_HIST_DATA_DOWNSTREAM_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_PERF_MON_HIST_DATA_DOWNSTREAM|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. Through an identical ID, this ME is implicitly linked to an instance of a MAC bridge port configuration data. (R, set-by-create) (mandatory) (2bytes)";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Threshold data 1/2 ID: This attribute points to an instance of the threshold data 1 ME that contains PM threshold values. Since no threshold value attribute number exceeds 7, a threshold data 2 ME is optional. (R,W, set-by-create) (mandatory) (2bytes)";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_PERF_MON_HIST_DATA_UPSTREAM {
      description
        "Ethernet frame performance monitoring history data upstream, Class Value 322. This ME collects PM data associated with upstream Ethernet frame delivery. It is based on the Etherstats group of [IETF RFC 2819]. Instances of this ME are created and deleted by the OLT. For a complete discussion of generic PM architecture, refer to clause I.4. NOTE1Implementers are encouraged to consider the Ethernet frame extended PM ME defined in clause9.3.32, which collects the same counters in a more generalized way. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_PERF_MON_HIST_DATA_UPSTREAM.";
      reference
        "G.988, 9.3.30, Ethernet frame performance monitoring history data upstream";
      list PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_PERF_MON_HIST_DATA_UPSTREAM_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_ETHERNET_FRAME_PERF_MON_HIST_DATA_UPSTREAM_MANAGED_ENTITY configuration.
