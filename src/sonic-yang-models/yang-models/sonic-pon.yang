          }
          description
            "References PON_ONU_OLT_SERVICE_STATE_LIST.";
        }
        leaf type {
          type string;
          description
            "Type of Downstream QoS Map.";
        }
      }
    }
    container PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_MAP_STATE {
      description
        "PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_MAP_STATE table in StateDB.";
      config false;
      list PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_MAP_STATE_LIST {
        key "onu-name olt-service-id priority";
        description
          "Mapping entry that classifies VLAN CoS bit values to a destination GPON XGEM Port (OLT-Service) offset.

           StateDB key: PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_MAP_STATE|<onu-name>|<olt-service-id>|<priority>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_STATE/sp:PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_STATE_LIST.";
        }
        leaf olt-service-id {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_STATE/sp:PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_STATE_LIST/sp:olt-service-id";
          }
          description
            "References PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_STATE_LIST.";
        }
        leaf priority {
          type uint8;
          description
            "Priority (CoS bit) value.";
        }
        leaf olt-service-offset {
          type uint8;
          description
            "Destination GPON XGEM Port offset that the start/end CoS values are classified to.";
        }
      }
    }
    container PON_ONU_OLT_SERVICE_NETWORK_STATE {
      description
        "PON_ONU_OLT_SERVICE_NETWORK_STATE table in StateDB.";
      config false;
      list PON_ONU_OLT_SERVICE_NETWORK_STATE_LIST {
        key "onu-name olt-service-id vlan-id";
        description
          "List of C-VLAN IDs through the service flow List of PON VLAN network through service flow
           StateDB key: PON_ONU_OLT_SERVICE_NETWORK_STATE|<onu-name>|<olt-service-id>|<vlan-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf olt-service-id {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_OLT_SERVICE_STATE/sp:PON_ONU_OLT_SERVICE_STATE_LIST/sp:olt-service-id";
          }
          description
            "References PON_ONU_OLT_SERVICE_STATE_LIST.";
        }
        leaf network-id {
          type uint16;
          description
            "Index for this entry.";
        }
        leaf vlan-id {
          type uint16 {
            range "0..4095";
          }
          description
            "VLAN ID.";
        }
        ordered-by system;
      }
    }
    container PON_ONU_UNI_STATE {
      description
        "PON_ONU_UNI_STATE table in StateDB.";
      config false;
      list PON_ONU_UNI_STATE_LIST {
        key "onu-name port-id";
        description
          "Status of the UNI ports on the ONU.
           StateDB key: PON_ONU_UNI_STATE|<onu-name>|<port-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf port-id {
          type string {
            pattern 'UNI-ETH\s[1-9][0-9]?';
          }
          description
            "Identifier for this UNI port.";
        }
        leaf duplex {
          type string;
          description
            "Sets the duplex for the Ethernet port";
        }
        leaf enable {
          type boolean;
          description
            "Current enable state of the Ethernet port";
        }
        leaf managed-entity-id {
          type uint16;
          description
            "OMCI Managed Entity Identifier for the UNI";
        }
        leaf max-frame-size {
          type uint32;
          description
            "Maximum Frame size limit on UNI receive";
        }
        leaf poe {
          type boolean;
          description
            "Power over Ethernet (PoE) status for the UNI port.";
          reference
            "ITU-T G.988 clause 9.5.1 Physical path termination point Ethernet UNI, Power control";
        }
        leaf speed {
          type string;
          description
            "Set the speed of the Ethernet port";
        }
        leaf state {
          type string;
          description
            "The link status of the UNI Ethernet port";
        }
      }
    }
