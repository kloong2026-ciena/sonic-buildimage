    container PON_OLT_STATISTICS_ACCUMULATING_TEMP {
      description
        "PON_OLT_STATISTICS_ACCUMULATING_TEMP table in CounterDB.";
      config false;
      list PON_OLT_STATISTICS_ACCUMULATING_TEMP_LIST {
        key "olt-name";
        description
          "OLT plug temperatures.
           CounterDB key: PON_OLT_STATISTICS_ACCUMULATING_TEMP|<olt-name>.";
        leaf olt-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF_STATE/sp:PON_OLT_INTF_STATE_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_STATE_LIST.";
        }
        leaf asic {
          type uint64;
          units "degrees celsius";
          description
            "ASIC temperature";
        }
        leaf laser {
          type uint64;
          units "degrees celsius";
          description
            "Laser temperature";
        }
        leaf xcvr {
          type uint64;
          units "degrees celsius";
          description
            "Transceiver temperature";
        }
      }
    }
