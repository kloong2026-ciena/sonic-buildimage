    container PON_SERVICE_CONFIG_PROFILE_THRESHOLD_DATA_ONE {
      description
        "Threshold data 1, Class Value 273. Threshold data are partitioned into two MEs for historical reasons. An instance of this ME, together with an optional instance of the threshold data 2 ME, contains threshold values for counters in PM history data MEs. For a complete discussion of generic PM architecture, refer to clause I.4. Instances of this ME are created and deleted by the OLT. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_THRESHOLD_DATA_ONE.";
      reference
        "G.988, 9.12.6, Threshold data 1";
      list PON_SERVICE_CONFIG_PROFILE_THRESHOLD_DATA_ONE_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_THRESHOLD_DATA_ONE_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_THRESHOLD_DATA_ONE|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. (R, set-by-create) (mandatory) (2bytes) The following seven attributes specify threshold values for seven thresholded counters in associated PM history data MEs. The definition of each PM history ME includes a table that links each thresholded counter to one of these threshold value attributes.";
        }
        leaf threshold-value-1 {
          type omci-types:omci-uint32;
          description
            "Threshold value1: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-2 {
          type omci-types:omci-uint32;
          description
            "Threshold value2: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-3 {
          type omci-types:omci-uint32;
          description
            "Threshold value3: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-4 {
          type omci-types:omci-uint32;
          description
            "Threshold value4: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-5 {
          type omci-types:omci-uint32;
          description
            "Threshold value5: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-6 {
          type omci-types:omci-uint32;
          description
            "Threshold value6: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-7 {
          type omci-types:omci-uint32;
          description
            "Threshold value7: (R,W, set-by-create) (mandatory) (4bytes)";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_THRESHOLD_DATA_TWO {
      description
        "Threshold data 2, Class Value 274. Together with an instance of the threshold data 1 ME, an instance of this ME contains threshold values for counters maintained in one or more instances of PM history data MEs. For a complete discussion of generic PM architecture, refer to clauseI.4. Instances of this ME are created and deleted by the OLT. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_THRESHOLD_DATA_TWO.";
      reference
        "G.988, 9.12.7, Threshold data 2";
      list PON_SERVICE_CONFIG_PROFILE_THRESHOLD_DATA_TWO_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_THRESHOLD_DATA_TWO_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_THRESHOLD_DATA_TWO|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. Its value is the same as that of the paired threshold data1instance. (R, set- by-create) (mandatory) (2bytes) The following seven attributes specify threshold values for seven thresholded counters in associated PM history data MEs. The definition of each PM history ME includes a table that links each thresholded counter to one of these threshold value attributes.";
        }
        leaf threshold-value-8 {
          type omci-types:omci-uint32;
          description
            "Threshold value8: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-9 {
          type omci-types:omci-uint32;
          description
            "Threshold value9: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-10 {
          type omci-types:omci-uint32;
          description
            "Threshold value10: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-11 {
          type omci-types:omci-uint32;
          description
            "Threshold value11: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-12 {
          type omci-types:omci-uint32;
          description
            "Threshold value12: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-13 {
          type omci-types:omci-uint32;
          description
            "Threshold value13: (R,W, set-by-create) (mandatory) (4bytes)";
        }
        leaf threshold-value-14 {
          type omci-types:omci-uint32;
          description
            "Threshold value14: (R,W, set-by-create) (mandatory) (4bytes)";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_TRAFFIC_DESCRIPTOR {
      description
        "Traffic descriptor, Class Value 280. The traffic descriptor is a profile that allows for traffic management. A priority controlled ONU can point from a MAC bridge port configuration data ME to a traffic descriptor in order to implement traffic management (marking, policing). A rate controlled ONU can point to a traffic descriptor from either a MAC bridge port configuration data ME or a GEM port network CTP to implement traffic management (marking, shaping). Packets are determined to be green, yellow or red as a function of the ingress packet rate and the settings in this ME. The colour indicates drop precedence (eligibility), subsequently used by the priority queue ME to drop packets conditionally during congestion conditions. Packet colour is also used by the optional mode 1 DBA status reporting function described in [ITU-T G.984.3]. Red packets are dropped immediately. Yellow packets are marked as drop eligible, and green packets are marked as not drop eligible, according to the egress colour marking attribute. The algorithm used to determine the colour marking is specified by the meter type attribute. If [b-IETF RFC 4115] is used, then: CIR4115=CIR EIR4115=PIR CIR (EIR: excess information rate) CBS4115=CBS EBS4115=PBS CBS. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_TRAFFIC_DESCRIPTOR.";
      reference
        "G.988, 9.2.12, Traffic descriptor";
      list PON_SERVICE_CONFIG_PROFILE_TRAFFIC_DESCRIPTOR_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_TRAFFIC_DESCRIPTOR_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_TRAFFIC_DESCRIPTOR|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. (R, set-by-create) (mandatory) (2bytes)";
        }
        leaf cir {
          type omci-types:omci-uint32;
          description
            "CIR: This attribute specifies the committed information rate, in bytes per second. The default is 0. (R,W, set-by-create) (optional) (4bytes)";
        }
        leaf pir {
          type omci-types:omci-uint32;
          description
            "PIR: This attribute specifies the peak information rate, in bytes per second. The default value 0 accepts the ONU's factory policy. (R,W, set-by-create) (optional) (4bytes)";
        }
        leaf cbs {
          type omci-types:omci-uint32;
          description
            "CBS: This attribute specifies the committed burst size, in bytes. The default is 0. (R,W, set-by-create) (optional) (4bytes)";
        }
        leaf pbs {
          type omci-types:omci-uint32;
          description
            "PBS: This attribute specifies the peak burst size, in bytes. The default value 0 accepts the ONU's factory policy. (R,W, set-by-create) (optional) (4bytes)";
        }
        leaf colour-mode {
          type omci-types:omci-uint8;
          description
            "Colour mode: This attribute specifies whether the colour marking algorithm considers pre-existing marking on ingress packets (colour-aware) or ignores it (colour-blind). In colour-aware mode, packets can only be demoted (from green to yellow or red, or from yellow to red). The default value is 0. 0 Colour-blind 1 Colour-aware (R,W, set-by-create) (optional) (1byte)";
        }
        leaf ingress-colour-marking {
          type omci-types:omci-uint8;
        }
        leaf egress-colour-marking {
          type omci-types:omci-uint8;
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_TRAFFIC_SCHEDULER {
      description
        "Traffic scheduler, Class Value 278. This ME models a logical scheduler that controls upstream GEM packet scheduling chains. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_TRAFFIC_SCHEDULER.";
      reference
        "G.988, 9.2.11, Traffic scheduler";
      list PON_SERVICE_CONFIG_PROFILE_TRAFFIC_SCHEDULER_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_TRAFFIC_SCHEDULER_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_TRAFFIC_SCHEDULER|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. This 2byte number indicates the physical capability that realizes the traffic scheduler. The first byte is the slot ID of the circuit pack with which this traffic scheduler is associated. For a traffic scheduler that is not associated with a circuit pack, the first byte is 0xFF. The second byte is the traffic scheduler id, assigned by the ONU itself. Traffic schedulers are numbered in ascending order with the range 0..0xFF in each circuit pack or in the ONU core. (R) (mandatory) (2bytes)";
        }
        leaf tcont-pointer {
          type omci-types:omci-uint16;
          description
            "T-CONT pointer: This attribute points to a T-CONT instance. (R,W, set-by- create) (mandatory) (2bytes)";
        }
        leaf policy {
          type omci-types:omci-uint8;
          description
            "Policy: This attribute represents scheduling policy. Valid values include: 0 Null 1 Strict priority 2 WRR (weighted round robin) The traffic scheduler derives priority or weight values for its tributary traffic schedulers or priority queues from the tributary MEs themselves. (R, W) (mandatory) (1 byte) NOTE 3 This attribute is read-only unless otherwise specified by the QoS configuration flexibility attribute of the ONU2-G ME. If flexible configuration is not supported, the ONU should reject an attempt to set the policy attribute with a parameter error result-reason code.";
        }
        leaf priority-weight {
          type omci-types:omci-uint8;
          description
            "Priority/weight: This attribute represents the priority for strict priority scheduling or the weight for WRR scheduling. This value is used by the next upstream ME, as indicated by the T-CONT pointer attribute or traffic scheduler pointer attribute. If the indicated pointer has policy=strict priority, this value is interpreted as a priority (0 is the highest priority, 255 the lowest). If the indicated pointer has policy=WRR, this value is interpreted as a weight. Higher values receive more bandwidth. Upon ME instantiation, the ONU sets this attribute to 0. (R,W) (mandatory) (1byte)";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_VIRTUAL_ETHERNET_INTERFACE_PT {
      description
        "Virtual Ethernet interface point, Class Value 329. This ME represents the data plane hand-off point in an ONU to a separate (non- OMCI) management domain. The VEIP is managed by the OMCI, and is potentially known to the non-OMCI management domain. One or more Ethernet traffic flows are present at this boundary. Instances of this ME are automatically created and deleted by the ONU. This is necessary because the required downstream priority queues are subject to physical implementation constraints. The OLT may use one or more of the VEIPs created by the ONU. It is expected that the ONU will create one VEIP for each non-OMCI management domain. At the vendor's discretion, a VEIP may be created for each traffic class. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_VIRTUAL_ETHERNET_INTERFACE_PT.";
      reference
        "G.988, 9.5.5, Virtual Ethernet interface point";
      list PON_SERVICE_CONFIG_PROFILE_VIRTUAL_ETHERNET_INTERFACE_PT_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_VIRTUAL_ETHERNET_INTERFACE_PT_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_VIRTUAL_ETHERNET_INTERFACE_PT|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. When used independently of a cardholder and circuit pack, the ONU should assign IDs in the sequence 1, 2, .... When used in conjunction with a cardholder and circuit pack, this 2 byte number indicates the physical position of the VEIP. The first byte is the slot ID (defined in clause 9.1.5). The second byte is the port ID, with the range 1..255. The values 0 and 0xFFFF are reserved. (R) (mandatory) (2 bytes)";
        }
        leaf administrative-state {
          type omci-types:omci-uint8;
          description
            "Administrative state: This attribute locks (1) and unlocks (0) the functions performed by this ME. Administrative state is further described in clause A.1.6. (R,W) (mandatory) (1byte)";
        }
        leaf interdomain-service-config-profile-name {
          type omci-types:omci-string;
        }
        leaf tcp-udp-pointer {
          type omci-types:omci-uint16;
          description
            "TCP/UDP pointer: This attribute points to an instance of the TCP/UDP config data ME, which provides for OMCI management of the non-OMCI management domain's IP connectivity. If no OMCI management of the non-OMCI domain's IP connectivity is required, this attribute may be omitted or set to its default, a null pointer. (R,W) (optional) (2bytes)";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_VLAN_TAGGING_FILTER_DATA {
      description
        "VLAN tagging filter data, Class Value 84. This ME organizes data associated with VLAN tagging. Instances of this ME are created and deleted by the OLT. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_VLAN_TAGGING_FILTER_DATA.";
      reference
        "G.988, 9.3.11, VLAN tagging filter data";
      list PON_SERVICE_CONFIG_PROFILE_VLAN_TAGGING_FILTER_DATA_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_VLAN_TAGGING_FILTER_DATA_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_VLAN_TAGGING_FILTER_DATA|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. Through an identical ID, this ME is implicitly linked to an instance of the MAC bridge port configuration data ME. (R, set-by-create) (mandatory) (2bytes)";
        }
        leaf forward-operation {
          type omci-types:omci-uint8;
          description
            "Forward operation: When a frame passes through the MAC bridge port, it is processed according to the operation specified by this attribute, in accordance with Table9.3.11-1. Figure 9.3.11-3 illustrates the treatment of frames according to the provisioned action possibilities. Tagged and untagged frames are treated separately, but both in accordance with Figure 9.3.11-3. While all forwarding operations are plausible, only actions 0x10 and 0x12 are necessary to construct a VLAN mapper and an 802.1p mapper, respectively. (R,W, set-by- create) (mandatory) (1byte) Table 9.3.11-1 contains duplicate entries due to simplification of the original set of actions. Table 9.3.11-1 and the actions listed are discussed in detail in the following.";
        }
        leaf number-of-entries {
          type omci-types:omci-uint8;
          description
            "Number of entries: This attribute specifies the number of valid entries in the VLAN filter list. (R,W, set-by-create) (mandatory) (1byte)";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_VLAN_TAGGING_FILTER_DATA_VLAN_FILTER {
      description
        "VLAN filter list entry for VLAN tagging filter data. Each entry contains a VLAN filter TCI value. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_VLAN_TAGGING_FILTER_DATA_VLAN_FILTER.";
      list PON_SERVICE_CONFIG_PROFILE_VLAN_TAGGING_FILTER_DATA_VLAN_FILTER_LIST {
        key "service-config-profile-name id managed-entity-id vlan-filter-entry-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_VLAN_TAGGING_FILTER_DATA_MANAGED_ENTITY_VLAN_FILTER configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_VLAN_TAGGING_FILTER_DATA_VLAN_FILTER|<service-config-profile-name>|<id>|<managed-entity-id>|<vlan-filter-entry-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf id {
          type string;
          description
            "Table entry number starting at '0'";
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. Through an identical ID, this ME is implicitly linked to an instance of the MAC bridge port configuration data ME. (R, set-by-create) (mandatory) (2bytes)";
        }
        leaf vlan-filter-entry-id {
          type uint8;
        }
        leaf vlan-id {
          type omci-types:omci-uint16;
          description
            "VLAN ID";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_XG_PON_DOWNSTREAM_MGMT_PERF_MON_HIST_DATA {
      description
        "XG-PON downstream management performance monitoring history data, Class Value 345. This ME collects PM data associated with the XG-PON TC layer. It collects counters associated with downstream PLOAM and OMCI messages. For a complete discussion of generic PM architecture, refer to clause I.4. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_XG_PON_DOWNSTREAM_MGMT_PERF_MON_HIST_DATA.";
      reference
        "G.988, 9.2.16, XG-PON downstream management performance monitoring history data";
      list PON_SERVICE_CONFIG_PROFILE_XG_PON_DOWNSTREAM_MGMT_PERF_MON_HIST_DATA_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_XG_PON_DOWNSTREAM_MGMT_PERF_MON_HIST_DATA_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_XG_PON_DOWNSTREAM_MGMT_PERF_MON_HIST_DATA|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. Through an identical ID, this ME is implicitly linked to an instance of the ANI-G. (R, set-by-create) (mandatory) (2bytes)";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Threshold data 1/2 ID: This attribute points to an instance of the threshold data 1 ME that contains PM threshold values. Since no threshold value attribute number exceeds 7, a threshold data 2 ME is optional. (R,W, set-by-create) (mandatory) (2bytes)";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_XG_PON_TC_PERF_MON_HIST_DATA {
      description
        "XG-PON TC performance monitoring history data, Class Value 344. This ME collects PM data associated with the XG-PON TC layer. For a complete discussion of generic PM architecture, refer to clause I.4. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_XG_PON_TC_PERF_MON_HIST_DATA.";
      reference
        "G.988, 9.2.15, XG-PON TC performance monitoring history data";
      list PON_SERVICE_CONFIG_PROFILE_XG_PON_TC_PERF_MON_HIST_DATA_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_XG_PON_TC_PERF_MON_HIST_DATA_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_XG_PON_TC_PERF_MON_HIST_DATA|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. Through an identical ID, this ME is implicitly linked to an instance of the ANI-G. (R, set-by-create) (mandatory) (2bytes)";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Threshold data 1/2 ID: This attribute points to an instance of the threshold data 1 ME that contains PM threshold values. (R,W, set-by-create) (mandatory) (2bytes)";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_XG_PON_UPSTREAM_MGMT_PERF_MON_HIST_DATA {
      description
        "XG-PON upstream management performance monitoring history data, Class Value 346. This ME collects PM data associated with the XG-PON TC layer. It counts upstream PLOAM messages transmitted by the ONU. For a complete discussion of generic PM architecture, refer to clause I.4. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_XG_PON_UPSTREAM_MGMT_PERF_MON_HIST_DATA.";
      reference
        "G.988, 9.2.17, XG-PON upstream management performance monitoring history data";
      list PON_SERVICE_CONFIG_PROFILE_XG_PON_UPSTREAM_MGMT_PERF_MON_HIST_DATA_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_XG_PON_UPSTREAM_MGMT_PERF_MON_HIST_DATA_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_XG_PON_UPSTREAM_MGMT_PERF_MON_HIST_DATA|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. Through an identical ID, this ME is implicitly linked to an instance of the ANI-G. (R, set-by-create) (mandatory) (2bytes)";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Threshold data 1/2 ID: No thresholds are defined for this ME. For uniformity with other PM, the attribute is retained and shown as mandatory, but it should be set to a null pointer. (R,W, set-by-create) (mandatory) (2bytes)";
        }
      }
    }
    container PON_SLA_PROFILE {
      description
        "PON_SLA_PROFILE table in ConfigDB.";
      list PON_SLA_PROFILE_LIST {
        key "sla-profile-name";
        description
          "List of SLA profiles.
           ConfigDB key: PON_SLA_PROFILE|<sla-profile-name>.";
        leaf sla-profile-name {
          description
            "Name identifier to reference this SLA profile.";
          type string {
            length "0..256";
          }
        }
        leaf downstream-guaranteed-rate {
          type uint32 {
            range "0..10000000 ";
          }
          units "kbps";
          default "128";
          description
            "Guaranteed (high priority) rate in kbps";
        }
        leaf downstream-guaranteed-maximum-burst {
          type uint32 {
            range "16000..1000000";
          }
          units "bytes";
          default "256000";
          description
            "Maximum burst size in Kilobytes. The guaranteed rate is enforced at this burst size.";
        }
        leaf downstream-best-effort-rate {
          type uint32 {
            range "0..10000000";
          }
          units "kbps";
          default "10000000";
          description
            "Best Effort (low priority) rate in kbps";
        }
        leaf downstream-best-effort-maximum-burst {
          type uint32 {
            range "16000..1000000";
          }
          units "bytes";
          default "256000";
          description
            "Maximum burst size in Kilobytes. The best effort rate is enforced at this burst size.";
        }
        leaf upstream-fixed-rate {
          type uint32 {
            range "0..8000000";
          }
          units "kbps";
          default "0";
          description
            "Fixed grant rate in kbps. This is an unsolicited grant by the DBA regardless of need.";
        }
        leaf upstream-guaranteed-rate {
          type uint32 {
            range "0..10000000";
          }
          units "kbps";
          default "128";
          description
            "Guaranteed (high priority) rate in kbps";
        }
        leaf upstream-guaranteed-maximum-burst {
          type uint32 {
            range "16000..1000000";
          }
          units "bytes";
          default "409600";
          description
            "Maximum burst size in Kilobytes. The guaranteed rate is enforced at this burst size.";
        }
        leaf upstream-priority {
          type uint8 {
            range "1..8";
          }
          default "1";
          description
            "Priority level for the guaranteed portion of the SLA.";
        }
        leaf upstream-best-effort-rate {
          type uint32 {
            range "0..10000000";
          }
          units "kbps";
          default "10000000";
          description
            "Best Effort (low priority) rate in kbps";
        }
        leaf upstream-best-effort-maximum-burst {
          type uint32 {
            range "16000..1000000";
          }
          units "bytes";
          default "409600";
          description
            "Maximum burst size in Kilobytes. The best effort rate is enforced at this burst size.";
        }
        leaf upstream-best-effort-priority {
          type uint8 {
            range "1..8";
          }
          default "1";
          description
            "Priority level for the Best Effort portion of the SLA.";
        }
      }
    }
    container PON_SLA_PROFILE_CONTROLLER {
      description
        "PON_SLA_PROFILE_CONTROLLER table in ConfigDB.";
      list PON_SLA_PROFILE_CONTROLLER_LIST {
        key "name";
        description
          "PON Controller related configuration.
           ConfigDB key: PON_SLA_PROFILE_CONTROLLER|<name>.";
        leaf name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_SLA_PROFILE/sp:PON_SLA_PROFILE_LIST/sp:sla-profile-name";
          }
          description
            "References PON_SLA_PROFILE_LIST.";
        }
      }
    }
    container PON_OLT_PLUG {
      description
        "PON_OLT_PLUG table in ConfigDB.";
      list PON_OLT_PLUG_LIST {
        key "olt-name";
        description
          "PON OLT plug attributes regrouped from PON_OLT_INTF.
           ConfigDB key: PON_OLT_PLUG|<olt-name>.";
        leaf olt-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF/sp:PON_OLT_INTF_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_LIST.";
        }
        leaf debug-log-level {
          type spt:logging-level;
          default "disable";
          description
            "Enables debug logging for this OLT plug.";
        }
        leaf fw-bank-ptr {
          type uint16 {
            range "0..3|65535";
          }
          default "65535";
          description
            "Firmware pointer to select bank (0 to 3) to be active on OLT plug. When this value changes, the OLT plug will be reset to load the firmware in the bank.";
        }
        leaf nni-max-frame-size {
          type uint32 {
            range "1518..12500";
          }
          default "9600";
          description
            "Maximum number of frame bytes from the DA to CRC32 for NNI receive path.
             (XGSPON-1518 to 9600)";
        }
      }
    }
    container PON_OLT_PROTECTION_GROUP {
      description
        "PON_OLT_PROTECTION_GROUP table in ConfigDB.";
      list PON_OLT_PROTECTION_GROUP_LIST {
        key "group-name";
        description
          "List of OLT PON protection groups.";
        leaf group-name {
          description
            "Name identifier used to reference this PON protection group.";
          type string {
            length "0..256";
          }
        }
        leaf admin-status {
          type boolean;
          default "true";
          description
            "Enables this PON protection group.";
        }
        leaf local-olt-interface {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF/sp:PON_OLT_INTF_LIST/sp:olt-intf-name";
          }
          description
            "On-box (local) OLT interface member of this protection group.";
        }
        leaf peer-olt {
          description
            "Peer OLT hosting the peer protection interface. Omit for same-switch (local) protection.";
          type string {
            length "0..256";
          }
        }
        leaf peer-olt-interface {
          when "../coordination-mode = 'stateful'";
          description
            "References a peer OLT interface that that contains protection PON interface.";
          type string {
            length "0..256";
          }
        }
        leaf coordination-mode {
          description
            "PON protection coordination mode.";
          type enumeration {
            enum stateful {
              description
                "OLT-to-OLT coordination present";
            }
            enum stateless {
              description
                "No coordination; independent protection logic";
            }
          }
          default "stateful";
        }
        leaf revertive {
          type boolean;
          default "false";
          description
            "Auto revert when primary OLT interface recovers.";
        }
      }
    }
    container PON_CONTROLLER_STATE {
      description
        "PON_CONTROLLER_STATE table in StateDB.";
      config false;
      list PON_CONTROLLER_STATE_LIST {
        key "name";
        description
          "List of PON Controllers.
           StateDB key: PON_CONTROLLER_STATE|<name>.";
        leaf name {
          type string;
          description
            "Name identifier to reference this PON Controller.";
        }
        leaf timestamp {
          type yang:date-and-time;
          description
            "The last update for this state file";
        }
        leaf allow-unprovisioned-onus {
          type boolean;
          description
            "When false, the controller only allows ONUs that have been inventoried on an OLT
             to complete registration.";
        }
        leaf config-read-failed {
          type boolean;
          description
            "When true, the configuration file is not in a valid format and can't be
             read by the controller. All processing is stopped on this device until this
             error is fixed.
            ";
        }
        leaf interface {
          type string;
          description
            "Network interface used by the controller";
        }
        leaf olt-timeout {
          type uint32;
          description
            "The amount of time that the PON controller will lock an OLT for exclusive management.  When this timer expires, another PON controller can take control of the OLT.";
        }
        leaf statistics-sample {
          type uint32;
          units "seconds";
          description
            "Current statistic sample interval";
        }
        leaf version {
          type string;
          description
            "Version of the controller";
        }
        leaf unprovisioned-age {
          type uint32;
          units "seconds";
          description
            "The amount of time an ONU will be kept in the Unprovisioned ONUs
             list, when no longer attempting registration.";
        }
      }
    }
    container PON_CONTROLLER_ONU_FW_UPGRADE_STATE {
      description
        "PON_CONTROLLER_ONU_FW_UPGRADE_STATE table in StateDB.";
      config false;
      list PON_CONTROLLER_ONU_FW_UPGRADE_STATE_LIST {
        key "name onu-id";
        description
          "The list of ONUs currently performing firmware upgrades on the PON Controller.
           StateDB key: PON_CONTROLLER_ONU_FW_UPGRADE_STATE|<name>|<onu-id>.";
        leaf name {
          type string;
        }
        leaf onu-id {
          type string;
          description
            "ONU device identifier (XGS-PON: ONU Serial Number)";
        }
      }
    }
    container PON_CONTROLLER_SYSTEM_STATUS_OLT {
      description
        "PON_CONTROLLER_SYSTEM_STATUS_OLT table in StateDB.";
      config false;
      list PON_CONTROLLER_SYSTEM_STATUS_OLT_LIST {
        key "controller-name mac-address";
        description
          "The list of OLT plugs currently registered on this PON Controller.
           StateDB key: PON_CONTROLLER_SYSTEM_STATUS_OLT|<controller-name>|<mac-address>.";
        leaf controller-name {
          type string;
          description
            "References PON_CONTROLLER_SYSTEM_STATUS_LIST.";
        }
        leaf mac-address {
          type yang:mac-address;
          description
            "OLT plug MAC address.";
        }
        leaf olt-state {
          type string;
          description
            "The current state of the OLT plug.";
        }
        leaf onu-active-count {
          type uint32;
          description
            "The number of ONUs that are active on this OLT plug.";
        }
        leaf switch-chassis-id {
          type string;
          description
            "MAC address of switch.";
        }
        leaf switch-ipv4-address {
          type string;
          description
            "IP Address of the switch.";
        }
        leaf switch-ipv6-address {
          type string;
          description
            "IP Address of the switch.";
        }
        leaf switch-port-description {
          type string;
          description
            "String description of the port.";
        }
        leaf switch-port-id {
          type string;
          description
            "String identification for the port.";
        }
        leaf switch-system-description {
          type string;
          description
            "System Description.";
        }
        leaf switch-system-name {
          type string;
          description
            "Name for the Switch.";
        }
      }
    }
    container PON_CONTROLLER_SYSTEM_STATUS_OLT_ONU {
      description
        "PON_CONTROLLER_SYSTEM_STATUS_OLT_ONU table in StateDB.";
      config false;
      list PON_CONTROLLER_SYSTEM_STATUS_OLT_ONU_LIST {
        key "name mac-address onu-serial-number";
        description
          "The list of ONUs currently registered on this OLT.
           StateDB key: PON_CONTROLLER_SYSTEM_STATUS_OLT_ONU|<name>|<mac-address>|<onu-serial-number>.";
        leaf name {
          type string;
        }
        leaf mac-address {
          type leafref {
            path "/sp:sonic-pon/sp:PON_CONTROLLER_SYSTEM_STATUS_OLT/sp:PON_CONTROLLER_SYSTEM_STATUS_OLT_LIST/sp:mac-address";
          }
          description
            "References PON_CONTROLLER_SYSTEM_STATUS_OLT_LIST.";
        }
        leaf onu-serial-number {
          type string;
          description
            "ONU serial number (defined by Vendor ID + Vendor SN).";
        }
        leaf onu-state {
          type string;
          description
            "The current state of the ONU.";
        }
      }
    }
    container PON_OLT_INTF_STATE {
      description
        "PON_OLT_INTF_STATE table in StateDB.";
      config false;
      list PON_OLT_INTF_STATE_LIST {
        key "olt-intf-name";
        description
          "List of OLT interfaces.
           StateDB key: PON_OLT_INTF_STATE|<olt-intf-name>";
        leaf olt-intf-name {
          type string;
          description
            "Name identifier to reference this OLT interface.";
        }
        leaf timestamp {
          type yang:date-and-time;
          description
            "The last update for this state file";
        }
        leaf protection-role {
          type enumeration {
            enum active {
              description
                "This OLT interface is the active member of its protection group.";
            }
            enum standby {
              description
                "This OLT interface is the standby member of its protection group.";
            }
            enum unknown {
              description
                "Transient / detecting; role not yet determined.";
            }
          }
          description
            "Protection role of THIS OLT interface..";
        }
        leaf fiber-reach {
          type enumeration {
            enum extended-0to40km {
              description
                "Configure the OLT interface for extended fiber reach, supporting ONUs with a distance from 0 to 40 kilometers.";
            }
            enum extended-40to60km {
              description
                "Configure the OLT interface for extended fiber reach, supporting ONUs with a distance from 40 to 60 kilometers.";
            }
            enum extended-20to40km {
              description
                "Configure the OLT interface for extended fiber reach, supporting ONUs with a distance from 20 to 40 kilometers.";
            }
            enum extended-10to30km {
              description
                "Configure the OLT interface for extended fiber reach, supporting ONUs with a distance from 10 to 30 kilometers.";
            }
            enum short {
              description
                "Configure the OLT interface for short fiber reach, supporting ONUs with a distance from 0 to 10 kilometers.";
            }
            enum standard {
              description
                "Configure the OLT interface for standard fiber reach, supporting ONUs with a distance from 0 to 20 kilometers.";
            }
            enum olt-default {
              description
                "Use the fiber reach value configured in the OLT interface flash (persistent store).";
            }
          }
          description
            "The current fiber reach configured on this OLT interface.";
        }
        leaf laser-shutdown {
          type string;
          description
            "Indicates the cause of a laser shutdown";
        }
        leaf loss-of-signal {
          type boolean;
          description
            "There are no ONUs registered on the OLT interface";
        }
        leaf pon-enable {
          type boolean;
          description
            "Current state of PON Optics on the module.";
        }
        leaf discovery-period {
          type uint32;
          description
            "Current OLT interface discovery time interval.";
        }
        leaf downstream-fec {
          type boolean;
          description
            "Current Forward Error Correction in the downstream direction.";
        }
        leaf encryption {
          type spt:olt-encryption-mode;
          description
            "Current OLT interface PON MAC layer encryption mode";
        }
        leaf encryption-key-time {
          type uint16;
          units "seconds";
          description
            "Time between changing encryption keys.";
        }
        leaf error-detection-maximum-hec-ratio {
          type uint8;
          units "percent";
          description
            "Maximum percentage of HEC errors to disable an ONU.";
        }
        leaf error-detection-minimum-hec-sample {
          type uint16;
          units "GPON headers";
          description
            "Minimum number of HEC error samples to consider for error-detection-maximum-ratio.";
        }
        leaf error-detection-maximum-ratio {
          type uint8;
          units "percent";
          description
            "Maximum percentage of errored upstream bursts to disable an ONU.";
        }
        leaf error-detection-minimum-sample {
          type uint16;
          units "Upstream Bursts";
          description
            "Minumum number of upstream bursts to consider for error-detection-maximum-ratio.";
        }
        leaf guard-time {
          type uint32;
          description
            "Current dead time between upstream burst slots.";
        }
        leaf mac-address {
          type yang:mac-address;
          description
            "GPON MAC Address.";
        }
        leaf max-frame-size {
          type uint32;
          description
            "Current maximum frame size allowed at the PON receiver";
        }
        leaf pon-id {
          type uint32;
          description
            "Unique 32-bit value assigned to each PON.";
        }
        leaf pon-tag {
          type string;
          description
            "PON-TAG description in burst profile message";
        }
        leaf port-id {
          type string {
            length "0..256";
          }
        }
        leaf device-id {
          type string {
            length "0..256";
          }
        }
        leaf aging-time {
          type uint16;
          units "seconds";
          description
            "Dynamic MAC Address aging time. When the aging time expires, the address is removed from the Dynamic MAC learning table.";
        }
      }
    }
    container PON_OLT_INTF_ONU_STATE {
      description
        "PON_OLT_INTF_ONU_STATE table in StateDB.";
      config false;
      list PON_OLT_INTF_ONU_STATE_LIST {
        key "olt-intf-name onu-serial-number";
        description
          "ONU related status.
           StateDB key: PON_OLT_INTF_ONU_STATE|<olt-intf-name>|<onu-serial-number>.";
        leaf olt-intf-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF_STATE/sp:PON_OLT_INTF_STATE_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_STATE_LIST.";
        }
        leaf onu-serial-number {
          type string;
          description
            "ONU serial number (defined by Vendor ID + Vendor SN).";
        }
        leaf onu-id {
          type uint16;
          description
            "The allocation ID, XGEM port ID, and ONU ID number assigned to this ONU to carry OMCI management messages.";
        }
        leaf disable {
          type boolean;
          description
            "When true, the disable serial number PLOAM message will be sent to this ONU if it tries to register.";
        }
        ordered-by system;
      }
    }
    container PON_OLT_INTF_ONU_FW_UPGRADE_STATE {
      description
        "PON_OLT_INTF_ONU_FW_UPGRADE_STATE table in StateDB.";
      config false;
      list PON_OLT_INTF_ONU_FW_UPGRADE_STATE_LIST {
        key "olt-intf-name onu-serial-number";
        description
          "The list of ONUs currently performing firmware upgrades on the OLT.
           StateDB key: PON_OLT_INTF_ONU_FW_UPGRADE_STATE|<olt-intf-name>|<onu-serial-number>.";
        leaf olt-intf-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF_ONU_STATE/sp:PON_OLT_INTF_ONU_STATE_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_ONU_STATE_LIST.";
        }
        leaf onu-serial-number {
          type string;
          description
            "ONU device identifier (XGS-PON ONU serial number)";
        }
      }
    }
    container PON_OLT_INTF_ONU_OPERATIONAL_STATE {
      description
        "PON_OLT_INTF_ONU_OPERATIONAL_STATE table in StateDB.";
      config false;
      list PON_OLT_INTF_ONU_OPERATIONAL_STATE_LIST {
        key "olt-intf-name id";
        description
          "Consolidated list of ONUs with their operational state.
           StateDB key: PON_OLT_INTF_ONU_OPERATIONAL_STATE|<olt-intf-name>|<id>.";
        leaf olt-intf-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF_ONU_STATE/sp:PON_OLT_INTF_ONU_STATE_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_ONU_STATE_LIST.";
        }
        leaf id {
          type string;
          description
            "ONU device identifier (XGS-PON ONU serial number)";
        }
        leaf operational-state {
          type enumeration {
            enum registered {
              description
                "ONU registered on OLT and specified in OLT configuration";
            }
            enum deregistered {
              description
                "ONU deregistered and specified in OLT configuration";
            }
            enum disabled {
              description
                "ONU deregistered due to disable serial number PLOAM";
            }
            enum disallowed-admin {
              description
                "ONU blocked by ONU Configuration file OLT specification";
            }
            enum disallowed-error {
              description
                "ONU blocked due to excessive upstream errors";
            }
            enum disallowed-registration-id {
              description
                "ONU blocked due to registration-id mismatch";
            }
            enum dying-gasp {
              description
                "ONU in dying gasp state (loss of power)";
            }
            enum unprovisioned {
              description
                "ONU not registered or not in OLT configuration";
            }
            enum unspecified {
              description
                "ONU registered but not specified in OLT configuration";
            }
            enum unknown {
              description
                "ONU state unknown or undefined";
            }
          }
          description
            "Current operational state of the ONU";
        }
      }
    }
    container PON_OLT_INTF_NETWORK_STATE {
      description
        "PON_OLT_INTF_NNI_NETWORK_STATE table in StateDB.";
      config false;
      list PON_OLT_INTF_NETWORK_STATE_LIST {
        key "olt-intf-name vlan-id";
        description
          "List of the NNI Networks configured on the OLT.
           StateDB key: PON_OLT_INTF_NETWORK_STATE|<olt-intf-name>|<vlan-id>.";
        leaf olt-intf-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF_STATE/sp:PON_OLT_INTF_STATE_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_STATE_LIST.";
        }
        leaf network-id {
          type uint16;
          description
            "Index of entry.";
        }
        leaf learning-limit {
          type uint16;
          description
            "Dynamic MAC learning table size limit for this NNI Network. A value of '0' indicates that MAC Learning is disabled for this NNI Network.";
        }
        leaf pon-flood-id {
          type uint16;
          description
            "XGEM Port ID for unknown/multicast/broadcast frames from this network.";
        }
        leaf vlan-id {
          type uint16 {
            range "0..4095";
          }
          description
            "VLAN id used to identify packets on the NNI network";
        }
        leaf flooding-sla-downstream-guaranteed-rate {
          type uint32;
          units "kbps";
          description
            "Guaranteed (high priority) rate in kbps.";
        }
        leaf flooding-sla-downstream-guaranteed-maximum-burst {
          type uint32;
          units "kBytes";
          description
            "Maximum burst size in Kilobytes. The guaranteed rate is enforced at this burst size.";
        }
        leaf flooding-sla-downstream-best-effort-rate {
          type uint32;
          units "kbps";
          description
            "Best Effort (low priority) rate in kbps.";
        }
        leaf flooding-sla-downstream-best-effort-maximum-burst {
          type uint32;
          units "kBytes";
          description
            "Maximum burst size in Kilobytes. The best effort rate is enforced at this burst size.";
        }
      }
    }
