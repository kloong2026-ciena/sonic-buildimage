    container PON_ONU_STATISTICS_ACCUMULATING_OLT_PON {
      description
        "PON_ONU_STATISTICS_ACCUMULATING_OLT_PON table in CounterDB.";
      config false;
      list PON_ONU_STATISTICS_ACCUMULATING_OLT_PON_LIST {
        key "onu-name";
        description
          "PON statistics for this ONU as represented on the OLT.
           CounterDB key: PON_ONU_STATISTICS_ACCUMULATING_OLT_PON|<onu-name>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf rx-optical-level {
          type decimal64 {
            fraction-digits 3;
          }
          units "dBm";
          description
            "Receive optical level.";
        }
        leaf tx-optical-level {
          type decimal64 {
            fraction-digits 3;
          }
          units "dBm";
          description
            "Transmit optical level.";
        }
        leaf rx-deregistrations {
          type uint64;
          description
            "Number of times the ONU has deregistered.";
        }
        leaf rx-registrations {
          type uint64;
          description
            "Number of times the ONU has completed registration.";
        }
        leaf fiber-distance {
          type decimal64 {
            fraction-digits 3;
          }
          units "kilometers";
          description
            "Reports the ONU fiber distance in kilometers.";
        }
        leaf equalization-delay {
          type uint64;
          units "upstream-slots(12.8ns)";
          description
            "Equalization delay assigned by the OLT to an ONU
             to ensure that the ONU's transmissions are aligned on a common
             upstream time reference.";
          reference
            "ITU-T G.9807.1 clause C.13.1";
        }
        leaf round-trip-time {
          type uint64;
          units "TQ(16ns)";
          description
            "Calculated Route Trip Time (RTT) between the OLT and ONU.";
          reference
            "IEEE 802.3av section 77.2.1.1";
        }
        leaf one-way-delay {
          type uint64;
          units "microseconds";
          description
            "One way delay reported for an ONU.";
        }
      }
    }
