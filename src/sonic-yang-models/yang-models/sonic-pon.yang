        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. Through an identical ID, this ME is implicitly linked to an instance of the PPTP Ethernet UNI. (R, set-by-create) (mandatory) (2bytes)";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Threshold data 1/2 ID: This attribute points to an instance of the threshold data 1 and 2 MEs that contains PM threshold values. (R,W, set-by-create) (mandatory) (2bytes)";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_ETHERNET_PERF_MON_HIST_DATA3 {
      description
        "Ethernet performance monitoring history data 3, Class Value 296. This ME collects PM data associated with an Ethernet interface. It includes parameters defined in the Ethernet statistics group of [IETF RFC 2819] that are not already covered by previously defined Ethernet monitoring MEs. The received direction is from the CPE towards the network (upstream). NOTE 1 Several of the same counters are available from the Ethernet frame PM history data MEs, which are associated with MAC bridge ports. MAC bridge port association allows those MEs to be used for any Ethernet flow, in both upstream and downstream directions, while the Ethernet PM history data 3 ME can only be used on a physical IEEE 802.3 port. Instances of this ME are created and deleted by the OLT. For a complete discussion of generic PM architecture, refer to clause I.4. NOTE 2 Implementers are encouraged to consider the Ethernet frame extended PM ME defined in clause9.3.32, which collects the same counters in a more generalized way. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_ETHERNET_PERF_MON_HIST_DATA3.";
      reference
        "G.988, 9.5.4, Ethernet performance monitoring history data 3";
      list PON_SERVICE_CONFIG_PROFILE_ETHERNET_PERF_MON_HIST_DATA3_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_ETHERNET_PERF_MON_HIST_DATA3_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_ETHERNET_PERF_MON_HIST_DATA3|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. Through an identical ID, this ME is implicitly linked to an instance of the PPTP Ethernet UNI. (R, set-by-create) (mandatory) (2bytes)";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Threshold data 1/2 ID: This attribute points to an instance of the threshold data 1 ME that contains PM threshold values. Since no threshold value attribute number exceeds 7, a threshold data 2 ME is optional. (R,W, set-by-create) (mandatory) (2bytes)";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_EXTENDED_VLAN_TAGGING_OPERATION_CONFIG_DATA {
      description
        "Extended VLAN tagging operation configuration data, Class Value 171. This ME organizes data associated with VLAN classification and tagging operations. Regardless of its point of attachment, the specified tagging operations refer to the upstream direction. Instances of this ME are created and deleted by the OLT. Through separate attributes, this ME supports either a Received frame VLAN tagging operation table attribute in its backward compatible form, or an enhanced frame classification and processing capability. The OLT can determine whether the ONU supports the enhanced capability through the Enhanced mode attribute of the ONU3-G ME. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_EXTENDED_VLAN_TAGGING_OPERATION_CONFIG_DATA.";
      reference
        "G.988, 9.3.13, Extended VLAN tagging operation configuration data";
      list PON_SERVICE_CONFIG_PROFILE_EXTENDED_VLAN_TAGGING_OPERATION_CONFIG_DATA_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_EXTENDED_VLAN_TAGGING_OPERATION_CONFIG_DATA_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_EXTENDED_VLAN_TAGGING_OPERATION_CONFIG_DATA|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute provides a unique number for each instance of this ME. (R, set-by-create) (mandatory) (2bytes)";
        }
        leaf association-type {
          type omci-types:omci-uint8;
          description
            "Association type: This attribute identifies the type of the ME associated with this extended VLAN tagging ME. Values are assigned as follows. 0 MAC bridge port configuration data 1 IEEE 802.1p mapper service profile 2 Physical path termination point Ethernet UNI 3 IP host config data or IPv6 host config data 4 Physical path termination point xDSL UNI 5 GEM IW termination point 6 Multicast GEM IW termination point 7 Physical path termination point MoCA UNI 8 Reserved 9 Ethernet flow termination point 10 Virtual Ethernet interface point 11 MPLS pseudowire termination point 12 EFM bonding group (R,W, set-by-create) (mandatory) (1byte) NOTE 1 If a MAC bridge is configured, code points 1, 5, 6 and 11 are associated with the ANI side of the MAC bridge. Code point 0 is associated with the ANI or UNI side, depending on the location of the MAC bridge port. The other code points are associated with the UNI side. When the extended VLAN tagging ME is associated with the ANI side, it behaves as an upstream egress rule, and as a downstream ingress rule when the downstream mode attribute is equal to 0. When the extended VLAN tagging ME is associated with the UNI side, the extended VLAN tagging ME behaves as an upstream ingress rule, and as a downstream egress rule when the downstream mode attribute is equal to 0.";
        }
        leaf input-tpid {
          type omci-types:omci-uint16;
          description
            "Input TPID: This attribute gives the special TPID value for operations on the input (filtering) side of the table. Typical values include 0x88A8 and 0x9100. (R,W) (mandatory) (2bytes)";
        }
        leaf output-tpid {
          type omci-types:omci-uint16;
          description
            "Output TPID: This attribute gives the special TPID value for operations on the output (tagging) side of the table. Typical values include 0x88A8 and 0x9100. (R,W) (mandatory) (2bytes)";
        }
        leaf downstream-mode {
          type omci-types:omci-uint8;
        }
        leaf associated-me-pointer {
          type omci-types:omci-uint16;
          description
            "Associated ME pointer: This attribute points to the ME with which this extended VLAN tagging operation configuration data ME is associated. (R,W, set-by- create) (mandatory) (2bytes) NOTE 5 When the association type is xDSL, the two MSBs may be used to indicate a bearer channel.";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_EXTENDED_VLAN_TAGGING_OPERATION_CONFIG_DATA_RECEIVED_FRAME_VLAN_TAGGING_OPERATION {
      description
        "Received frame VLAN tagging operation table entry for Extended VLAN tagging operation configuration data. Each entry defines a frame filter and VLAN treatment rule. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_EXTENDED_VLAN_TAGGING_OPERATION_CONFIG_DATA_RECEIVED_FRAME_VLAN_TAGGING_OPERATION.";
      list PON_SERVICE_CONFIG_PROFILE_EXTENDED_VLAN_TAGGING_OPERATION_CONFIG_DATA_RECEIVED_FRAME_VLAN_TAGGING_OPERATION_LIST {
