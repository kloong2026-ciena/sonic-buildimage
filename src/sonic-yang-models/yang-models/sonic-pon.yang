        key "onu-name";
        description
          "PON statistics reported by ONU.
           CounterDB key: PON_ONU_STATISTICS_ACCUMULATING_ONU_PON|<onu-name>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf rx-optical-level {
          type decimal64 {
            fraction-digits 3;
          }
          units "dBm";
          description
            "Receive Optical Level";
        }
        leaf tx-optical-level {
          type decimal64 {
            fraction-digits 3;
          }
          units "dBm";
          description
            "Transmit Optical Level";
        }
      }
    }
