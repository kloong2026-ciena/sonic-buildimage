        }
        leaf jabbers {
          type uint64;
          description
            "Total number of packets received that were longer than 1518 octets";
        }
        leaf multicast-packets {
          type uint64;
          description
            "Total number of received good packets directed to a multicast address. This does not include broadcast packets";
        }
        leaf octets {
          type uint64;
          description
            "Total number of octets received from the CPE, including those in bad packets";
        }
        leaf packets {
          type uint64;
          description
            "Total number of packets received, including bad packets, broadcast packets and multicast packets";
        }
        leaf packets-64-octets {
          type uint64;
          description
            "Total number of received packets (including bad packets) that were 64 octets long";
        }
        leaf packets-65-to-127-octets {
          type uint64;
          description
            "Total number of received packets (including bad packets) that were 65 to 127 octets long";
        }
        leaf packets-128-to-255-octets {
          type uint64;
          description
            "Total number of received packets (including bad packets) that were 128 to 255 octets long";
        }
        leaf packets-256-to-511-octets {
          type uint64;
          description
            "Total number of received packets (including bad packets) that were 256 to 511 octets long";
        }
        leaf packets-512-to-1023-octets {
          type uint64;
          description
            "Total number of received packets (including bad packets) that were 512 to 1023 octets long";
        }
        leaf packets-1024-to-1518-octets {
          type uint64;
          description
            "Total number of received packets (including bad packets) that were 1024 to 1518 octets long";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Points to an instance of the threshold data 1 ME that contains PM threshold values";
        }
