    container PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_EXTENDED_PM {
      description
        "Ethernet frame extended PM, Class Value 334. This ME collects some of the PM data at a point where an Ethernet flow can be observed. It is based on the Etherstats group of [IETF RFC 2819]. Instances of this ME are created and deleted by the OLT. References to received frames are to be interpreted as the number of frames entering the monitoring point in the direction specified by the control block. For a complete discussion of generic PM architecture, refer to clause I.4. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_EXTENDED_PM.";
      reference
        "G.988, 9.3.32, Ethernet frame extended PM";
      list PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_EXTENDED_PM_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_ETHERNET_FRAME_EXTENDED_PM_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_EXTENDED_PM|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. To facilitate discovery, the identification of instances sequentially starting with 1 is encouraged. (R, set-by-create) (mandatory) (2 bytes)";
        }
        leaf threshold-data-id {
          type omci-types:omci-uint16;
