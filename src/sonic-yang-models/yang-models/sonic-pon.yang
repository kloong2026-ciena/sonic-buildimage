          type omci-types:omci-uint16;
          description
            "accumulation disable";
        }
        leaf tca-disable {
          type omci-types:omci-uint16;
          description
            "tca disable";
        }
        leaf control-fields {
          type omci-types:omci-uint16;
          description
            "control fields";
        }
        leaf tci {
          type omci-types:omci-uint16;
          description
            "tci";
        }
        leaf reserved {
          type omci-types:omci-uint16;
          description
            "reserved";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_ETHERNET_FRAME_EXTENDED_PM64_BIT {
