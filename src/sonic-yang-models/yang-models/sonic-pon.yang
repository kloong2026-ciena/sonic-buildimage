module sonic-pon {
  namespace "http://github.com/sonic-net/sonic-pon";
  prefix sp;
  yang-version 1.1;

  import ietf-yang-types {
    prefix yang;
  }
  import sonic-pon-types {
    prefix spt;
  }
  import sonic-port {
    prefix sport;
  }
  import sonic-pon-omci-types {
    prefix omci-types;
  }

  organization
    "SONiC";
  contact
    "SONiC";
  description
    "Sonic PON YANG module covering PON configuration and state.";

  container sonic-pon {
    description
      "Top-level container for all SONIC PON.";
    container PON_CONTROLLER {
      description
        "PON_CONTROLLER table in ConfigDB.";
      list PON_CONTROLLER_LIST {
        key "controller-name";
        description
          "List of PON Controller configuration records.
           ConfigDB key: PON_CONTROLLER|<controller-name>.";
        leaf controller-name {
          description
            "Name identifier to reference this PON Controller.";
          type string {
            length "0..256";
          }
        }
        leaf device-id {
          type string {
            pattern '([0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5})|(Default)';
          }
          mandatory true;
          description
            "PON Controller identifier (PON Controller MAC Address or 'Default').";
        }
        leaf allow-unprovisioned-onus {
          type boolean;
          default "true";
          description
            "Allow unprovisioned ONUs to complete registration with PON Controller. When
             false, the controller only allows ONUs that have been inventoried on an OLT to complete
             registration.";
        }
        leaf olt-timeout {
          type uint32;
          default "300";
          description
            "The amount of time for OLT plug to be locked to a controller.  If an OLT plug doesn't receive OAM from the PON Controller in this time period, it will release its lock to allow another PON controller to manage it.";
        }
        leaf statistics-sample {
          type uint32;
          units "seconds";
          default "300";
          description
            "Minimum time between OLT statistic samples. After this amount of time, statistics will be gathered for the network devices.";
        }
        leaf logging-controller-console {
          type spt:logging-level;
          default "info";
          description
            "Severity level for log messages sent to the console.";
        }
        leaf logging-controller-file {
          type spt:logging-level;
          default "info";
          description
            "Severity level for log messages sent to the log file.";
        }
        leaf logging-controller-syslog {
          type spt:logging-level;
          default "info";
          description
            "Severity level for log messages sent to the Syslog.";
        }
        leaf logging-controller-database {
          type spt:logging-level;
          default "info";
          description
            "Severity level for logs messages sent to the database.";
        }
        leaf logging-olt-console {
          type spt:logging-enable;
          default "disable";
          description
            "Enable log messages to be sent to the console.";
        }
        leaf logging-olt-file {
          type spt:logging-enable;
          default "disable";
          description
            "Enable log messages to be sent to the log file.";
        }
        leaf logging-olt-syslog {
          type spt:logging-enable;
          default "disable";
          description
            "Enable log messages to be sent to the Syslog.";
        }
        leaf olt-management-interface-name {
          type string;
        }
        leaf unprovisioned-age {
          type uint32 {
            range "60..86400";
          }
          units "seconds";
          default "900";
          description
            "The amount of time an ONU will be kept in the Unprovisioned ONUs
             list, when no longer attempting registration.";
        }
      }
    }
    container PON_DOWNSTREAM_QOS_MAP_MAP {
      description
        "PON_DOWNSTREAM_QOS_MAP_MAP table in ConfigDB.";
      list PON_DOWNSTREAM_QOS_MAP_MAP_LIST {
        key "name cos";
        description
          "Mapping entry that classifies VLAN CoS bit values to a destination GPON XGEM Port (OLT-Service) offset.

           ConfigDB key: PON_DOWNSTREAM_QOS_MAP_MAP|<name>|<cos>.";
        leaf name {
          type string;
        }
        leaf cos {
          type uint8 {
            range "0..7";
          }
          description
            "VLAN CoS/Priority bit value for this classifier.";
        }
        leaf olt-service-offset {
          type uint8 {
            range "0..7";
          }
          description
            "Destination GPON XGEM Port offset that the start/end CoS values are classified to.";
        }
      }
    }
    container PON_OLT_INTF {
      description
        "PON_OLT_INTF table in ConfigDB.";
      list PON_OLT_INTF_LIST {
        key "olt-intf-name";
        description
          "List of OLT interfaces.
           ConfigDB key: PON_OLT_INTF|<olt-intf-name>";
        leaf olt-intf-name {
          description
            "Name identifier to reference this OLT interface.";
          type string {
            length "0..256";
          }
        }
        leaf device-id {
          type string {
            pattern '([0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5})|(Default)';
          }
          description
            "OLT interface identifier (OLT interface MAC Address or 'Default').";
        }
        leaf port-id {
          mandatory true;
          type leafref {
            path "/sport:sonic-port/sport:PORT/sport:PORT_LIST/sport:name";
          }
        }
        leaf pon-enable {
          type boolean;
          description
            "Enable the PON Optics on the module.";
          default "false";
        }
        leaf discovery-period {
          type uint32 {
            range "0 | 100..10000";
          }
          units "milliseconds";
          default "3000";
          description
            "Amount of time between discovery slots on the PON. A setting of '0' will disable discovery.";
        }
        leaf downstream-fec {
          type boolean;
          default "true";
          description
            "Enable Forward Error Correction in the downstream direction.";
        }
        leaf encryption {
          type spt:olt-encryption-mode;
          default "disabled";
          description
            "Enable the OLT interface for PON MAC layer encryption of data.";
        }
        leaf encryption-key-time {
          type uint16 {
            range "60..3600";
          }
          units "seconds";
          default "600";
          description
            "Time between changing encryption keys.";
        }
        leaf error-detection-maximum-hec-ratio {
          type uint8 {
            range "0..100";
          }
          units "percent";
          default "20";
          description
            "Maximum percentage of HEC errors to disable an ONU.";
        }
        leaf error-detection-minimum-hec-sample {
          type uint16 {
            range "0..1000";
          }
          units "GPON headers";
          default "100";
          description
            "Minimum number of HEC error samples to consider for error-detection-maximum-ratio.";
        }
        leaf error-detection-maximum-ratio {
          type uint8 {
            range "0..100";
          }
          units "percent";
          default "20";
          description
            "Maximum percentage of errored upstream bursts to disable an ONU.";
        }
        leaf error-detection-minimum-sample {
          type uint16 {
            range "0..1000";
          }
          units "Upstream Bursts";
          default "100";
          description
            "Minimum number of upstream bursts to consider for error-detection-maximum-ratio.";
        }
        leaf guard-time {
          type uint32 {
            range "16..1000";
          }
          units "upstream-slots(12.8ns)";
          default "64";
          description
            "Amount of dead time between upstream burst slots. The Guard Time should be enough for slot jitter and ONU laser off time.";
        }
        leaf max-frame-size {
          type uint32 {
            range "1518..9600";
          }
          units "octets";
          default "9600";
          description
            "Maximum frame size allowed at the PON receiver from DA to CRC32.";
        }
        leaf pon-id {
          type uint32;
          default "0";
          description
            "Unique 32-bit value assigned to each PON.";
        }
        leaf pon-tag {
          type string {
            length "0|16";
          }
          default "";
          description
            "PON-TAG description in burst profile message";
        }
        leaf aging-time {
          type uint16 {
            range "60..3600";
          }
          units "seconds";
          default "300";
          description
            "Dynamic MAC Address aging time. When the aging time expires, the address is removed from the Dynamic MAC learning table.";
        }
        leaf protection-hold {
          type boolean;
          default "false";
          description
            "When true, automatic protection actions on this OLT interface are held.
             This control is intended for external orchestration.
             When false, automatic protection behavior is allowed.";
        }
      }
    }
    container PON_OLT_INTF_NETWORK {
      description
        "PON_OLT_INTF_NETWORK table in ConfigDB.";
      list PON_OLT_INTF_NETWORK_LIST {
        key "olt-intf-name vlan-id";
        description
          "List of networks to pre-define.
           ConfigDB key: PON_OLT_INTF_NETWORK|<olt-intf-name>|<vlan-id>.";
        leaf olt-intf-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF/sp:PON_OLT_INTF_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_LIST.";
        }
        leaf network-id {
          type uint16 {
            range "0..999";
          }
          description
            "Index for this entry.";
        }
        leaf learning-limit {
          type uint16 {
            range "0..2046";
          }
          default "2046";
          description
            "Dynamic MAC learning table size limit for this NNI Network. A value of '0' disables MAC Learning for this NNI Network.";
        }
        leaf flooding-gemport-id {
          type uint16 {
            range "1154..1278|1280..1534|1919..2046|5121..5374|5376..5630|5632..5886|5888..6013";
          }
          description
            "Flooding (Broadcast DA, Multicast DA, unknown DA downstream packets) XGEM Port ID (XGS mode only) to use for this network.";
        }
        leaf vlan-id {
          type uint16 {
            range "0..4095";
          }
          description
            "VLAN id used to identify packets on the NNI network";
        }
        leaf flooding-sla-profile {
          type string;
          description
            "SLA profile for the flooding link on this NNI network.";
        }
        ordered-by system;
      }
    }
    container PON_OLT_INTF_ONU {
      description
        "PON_OLT_INTF_ONU table in ConfigDB.";
      list PON_OLT_INTF_ONU_LIST {
        key "olt-intf-name onu-serial-number";
        description
          "For each ONU (defined by Vendor ID + Vendor SN) and service port on the ONU, the Allocation ID to use for the service port. Use 65535 or don't specify for automatic assignment.
           ConfigDB key: PON_OLT_INTF_ONU|<olt-intf-name>|<onu-serial-number>.";
        leaf olt-intf-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF/sp:PON_OLT_INTF_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_LIST.";
        }
        leaf onu-serial-number {
          description
            "ONU serial number (defined by Vendor ID + Vendor SN).";
          type string {
            length "0..256";
          }
        }
        leaf onu-id {
          type uint16 {
            range "1..128";
          }
          description
            "The allocation ID, XGEM port ID, and ONU ID number assigned to this ONU to carry OMCI management messages.";
        }
        leaf disable {
          type boolean;
          default "false";
          description
            "When true, the disable serial number PLOAM message will be sent to this ONU if it tries to register.";
        }
        ordered-by system;
      }
    }
    container PON_OLT_INTF_ONU_OLT_SERVICE {
      description
        "PON_OLT_INTF_ONU_OLT_SERVICE table in ConfigDB.";
      list PON_OLT_INTF_ONU_OLT_SERVICE_LIST {
        key "olt-intf-name onu-serial-number service-port-id";
        description
          "List of OLT Service ports.
           ConfigDB key: PON_OLT_INTF_ONU_OLT_SERVICE|<olt-intf-name>|<onu-serial-number>|<service-port-id>.";
        leaf olt-intf-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF/sp:PON_OLT_INTF_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_LIST.";
        }
        leaf onu-serial-number {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF_ONU/sp:PON_OLT_INTF_ONU_LIST/sp:onu-serial-number";
          }
          description
            "References PON_OLT_INTF_ONU_LIST.";
        }
        leaf service-port-id {
          type uint32 {
            range "0..7";
          }
          description
            "OLT Service port number.";
        }
        leaf unicast-id {
          description
            "The Allocation ID to use for the service port. Use 65535 or don't specify
             for automatic assignment. Valid ALLOC-ID range is 1154..1534, excluding 1279.
            ";
          type uint16 {
            range "1154..1278 | 1280..1534";
          }
        }
      }
    }
    container PON_OLT_INTF_ONU_SERVICE_TCONT {
      description
        "PON_OLT_INTF_ONU_SERVICE_TCONT table in ConfigDB.";
      list PON_OLT_INTF_ONU_SERVICE_TCONT_LIST {
        key "olt-intf-name onu-serial-number olt-service-id";
        description
          "List of OLT Service ports.
           ConfigDB key: PON_OLT_INTF_ONU_SERVICE_TCONT|<olt-intf-name>|<onu-serial-number>|<olt-service-id>.";
        leaf olt-intf-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF/sp:PON_OLT_INTF_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_LIST.";
        }
        leaf onu-serial-number {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF_ONU/sp:PON_OLT_INTF_ONU_LIST/sp:onu-serial-number";
          }
          description
            "References PON_OLT_INTF_ONU_LIST.";
        }
        leaf olt-service-id {
          type uint32 {
            range "0..7";
          }
          description
            "OLT Service port number.";
        }
        leaf alloc-id {
          description
            "The Allocation ID to use for the service port. Use 65535 or don't specify
             for automatic assignment. Valid ALLOC-ID range is 1154..1534, excluding 1279.
            ";
          type uint16 {
            range "1154..1278 | 1280..1534";
          }
        }
      }
    }
    container PON_OLT_INTF_ONU_SERVICE_GEMPORT {
      description
        "PON_OLT_INTF_ONU_SERVICE_GEMPORT table in ConfigDB.";
      list PON_OLT_INTF_ONU_SERVICE_GEMPORT_LIST {
        key "olt-intf-name onu-serial-number olt-service-id";
        description
          "List of OLT GEM ports.
           ConfigDB key: PON_OLT_INTF_ONU_SERVICE_GEMPORT|<olt-intf-name>|<onu-serial-number>|<olt-service-id>.";
        leaf olt-intf-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF/sp:PON_OLT_INTF_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_LIST.";
        }
        leaf onu-serial-number {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF_ONU/sp:PON_OLT_INTF_ONU_LIST/sp:onu-serial-number";
          }
          description
            "References PON_OLT_INTF_ONU_LIST.";
        }
        leaf olt-service-id {
          type uint32 {
            range "0..7";
          }
          description
            "OLT Service port number.";
        }
        leaf gemport-id {
          description
            "GEM port ID for the service port.";
          type uint16;
        }
        leaf tcont-ref {
          description
            "References the TCONT entry associated with this GEM port.";
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF_ONU_SERVICE_TCONT/sp:PON_OLT_INTF_ONU_SERVICE_TCONT_LIST/sp:olt-service-id";
          }
        }
      }
    }
    container PON_OLT_PLUG_FW_BANK_FILE {
      description
        "PON_OLT_PLUG_FW_BANK_FILE table in ConfigDB.";
      list PON_OLT_PLUG_FW_BANK_FILE_LIST {
        key "olt-name bank-id";
        description
          "The database files to get firmware for the firmware banks on the OLT Module. The OLT module supports 4 banks of firmware. The list is ordered Bank0, Bank1, Bank2, and Bank3.
           ConfigDB key: PON_OLT_PLUG_FW_BANK_FILE|<olt-name>|<bank-id>.";
        leaf olt-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_PLUG/sp:PON_OLT_PLUG_LIST/sp:olt-name";
          }
          description
            "References PON_OLT_PLUG_LIST.";
        }
        leaf bank-id {
          type uint8 {
            range "0..3";
          }
          description
            "Index for this entry.";
        }
        leaf file {
          description
            "Name of the firmware file.";
          type string {
            length "0..256";
          }
        }
        leaf version {
          description
            "Name of the firmware file version.";
          type string {
            length "0..256";
          }
        }
        max-elements 4;
        ordered-by system;
      }
    }
    container PON_ONU_TEMPLATE_ONU {
      description
        "PON_ONU_TEMPLATE_ONU table in ConfigDB.";
      list PON_ONU_TEMPLATE_ONU_LIST {
        key "onu-template-name";
        description
          "ONU specific settings.
           ConfigDB key: PON_ONU_TEMPLATE_ONU|<onu-template-name>.";
        leaf onu-template-name {
          type string;
          description
            "References PON_ONU_TEMPLATE_LIST.";
        }
        leaf vlan-id {
          type uint16 {
            range "0..4095";
          }
          description
            "VID for service configuration.";
        }
        leaf fw-bank-ptr {
          type uint16 {
            range "0..1|65535";
          }
          default "65535";
          description
            "Current Firmware bank pointer. A value of '65535' disables ONU firmware upgrade.";
        }
        leaf service-config {
          type string {
            length "0..64";
          }
          units "'Disabled' or 'Add CTag' or 'Unmodified' or <Service Config Name>";
          default "Disabled";
          description
            "ONU Service Configuration has 3 generic built-in modes and the ability to load a service configuration from the database.
             XGS supports all 3 configurations and service configuration files.
            ";
        }
        leaf service-config-omci-stats {
          type boolean;
          default "false";
          description
            "When set to true, no OMCI PM MEs will be automatically configured by the Controller.
             The PM MEs need to be specified in the ONU's SRV-CONFIG file.";
        }
        leaf fw-upgrade-backoff-delay {
          type uint32 {
            range "1..10";
          }
          units "seconds";
          default "5";
          description
            "Time to wait before retransmitting a window.";
        }
        leaf fw-upgrade-backoff-divisor {
          type uint32 {
            range "1..2";
          }
          default "2";
          description
            "Controls the size of the send window during retransmissions. A value of '2' reduces
             the send window size by half for each retransmission. A value of '1' disables the backoff.";
        }
        leaf fw-upgrade-download-format {
          type spt:fw-download-format;
          default "baseline-omci";
          description
            "The format of OMCI the PON Controller will use to upgrade the ONU, regardless of the OMCC Version it reported.";
        }
        leaf fw-upgrade-end-download-timeout {
          type uint32 {
            range "0..600";
          }
          units "seconds";
          default "0";
          description
            "Time to wait for the final acknowledgement during firmware upgrade. Increase the value
             to allow the ONU additional time to write the firmware image to flash. The PON Controller
             automatically calculates the end-download-timeout when set to a value of zero.
            ";
        }
        leaf fw-upgrade-maximum-retries {
          type uint32 {
            range "1..10";
          }
          default "4";
          description
            "Maximum number of times a window is retransmitted before terminating the ONU
             firmware upgrade and reporting an error.
            ";
        }
        leaf fw-upgrade-maximum-window-size {
          type uint32 {
            range "16..256";
          }
          units "bytes";
          default "64";
          description
            "The maximum send window sized used for transfering firmware to the ONU.";
        }
        leaf fw-upgrade-response-timeout {
          type uint32 {
            range "3..120";
          }
          units "seconds";
          default "3";
          description
            "The time in seconds to wait for an acknowledgement from the ONU during firmware upgrade.";
        }
      }
    }
    container PON_ONU_TEMPLATE_ONU_FW_BANK_FILE {
      description
        "PON_ONU_TEMPLATE_ONU_FW_BANK_FILE table in ConfigDB.";
      list PON_ONU_TEMPLATE_ONU_FW_BANK_FILE_LIST {
        key "onu-template-name bank-id";
        description
          "XGS-PON: firmware source filenames for bank 0 (1st in list) and bank 1 if version doesn't match.

           ConfigDB key: PON_ONU_TEMPLATE_ONU_FW_BANK_FILE|<onu-template-name>|<bank-id>.";
        leaf onu-template-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_TEMPLATE_ONU/sp:PON_ONU_TEMPLATE_ONU_LIST/sp:onu-template-name";
          }
          description
            "References PON_ONU_TEMPLATE_ONU_LIST.";
        }
        leaf bank-id {
          type uint8 {
            range "0..1";
          }
          description
            "Index for this entry.";
        }
        leaf file {
          type string {
            length "0..64";
          }
          description
            "Name of the firmware file.";
        }
        leaf version {
          type string {
            length "0..64";
          }
          description
            "Version.";
        }
        max-elements 2;
        ordered-by system;
      }
    }
    container PON_ONU_TEMPLATE_OLT_SERVICE {
      description
        "PON_ONU_TEMPLATE_OLT_SERVICE table in ConfigDB.";
      list PON_ONU_TEMPLATE_OLT_SERVICE_LIST {
        key "onu-template-name olt-service-id";
        description
          "OLT Configuration for the services. 0 to 7 services can be configured. A service is an XGEM Port ID/Alloc ID in XGS-PON.
           ConfigDB key: PON_ONU_TEMPLATE_OLT_SERVICE|<onu-template-name>|<olt-service-id>.";
        leaf onu-template-name {
          type string;
        }
        leaf olt-service-id {
          type uint32 {
            range "0..7";
          }
          description
            "OLT Service Port number.";
        }
        leaf downstream-qos-map {
          type string {
            length "0..64";
          }
          default "";
          description
            "Reference to a Downstream QoS Map. Used with multiple XGem configurations.";
        }
        leaf enable {
          type boolean;
          default "false";
          description
            "True to enable this service port.  False to disable it.";
        }
        leaf learning-limit {
          type uint16 {
            range "0..2046";
          }
          default "2046";
          description
            "Dynamic MAC learning table size limit for this service port. A value of '0' disables MAC Learning for this service.";
        }
        leaf sla-profile {
          type string {
            length "0..64";
          }
          default "Max";
          description
            "Service level agreements for the service flow.";
        }
        leaf tcont-service-ref {
          type string {
            pattern "none|[0-7]";
          }
          description
            "none - OLT Service Port operates as a TCONT + XGem Port.
             TCONT OLT Service Port reference used to configure multiple XGem Ports for
             a single TCONT. When the value is set to a 'none', this OLT Service port operates as a
             TCONT + XGem Port. When the value references another OLT Service Port 0..7, this
             OLT Service port operates as an XGem Port only. When operating as an XGem only, this value
             must reference another OLT Service Port operating in TCONT + XGem mode.
            ";
        }
        max-elements 8;
        ordered-by system;
      }
    }
    container PON_ONU_TEMPLATE_OLT_SERVICE_NETWORK {
      description
        "PON_ONU_TEMPLATE_OLT_SERVICE_NETWORK table in ConfigDB.";
      list PON_ONU_TEMPLATE_OLT_SERVICE_NETWORK_LIST {
        key "onu-template-name olt-service-id vlan-id";
        description
          "List of VLAN network(s) (NNI and PON) through the service flow. VLAN Networks are defined by the SVLAN VID and two CVLAN VIDs.
           ConfigDB key: PON_ONU_TEMPLATE_OLT_SERVICE_NETWORK|<onu-template-name>|<olt-service-id>|<vlan-id>.";
        leaf onu-template-name {
          type string;
        }
        leaf olt-service-id {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_TEMPLATE_OLT_SERVICE/sp:PON_ONU_TEMPLATE_OLT_SERVICE_LIST/sp:olt-service-id";
          }
          description
            "References PON_ONU_TEMPLATE_OLT_SERVICE_LIST.";
        }
        leaf network-id {
          type uint16 {
            range "0..999";
          }
          description
            "Index for this entry.";
        }
        leaf vlan-id {
          type uint16 {
            range "0..4095";
          }
          description
            "VID service configuration.";
        }
        max-elements 1000;
        ordered-by system;
      }
    }
    container PON_ONU_TEMPLATE_SERVICE_CONFIG_VALUE {
      description
        "PON_ONU_TEMPLATE_SERVICE_CONFIG_VALUE table in ConfigDB.";
      list PON_ONU_TEMPLATE_SERVICE_CONFIG_VALUE_LIST {
        key "onu-template-name cfg-name";
        description
          "Service configuration file parameter 'onu-template-name' = 'value' pairs.
           ConfigDB key: PON_ONU_TEMPLATE_SERVICE_CONFIG_VALUE|<onu-template-name>|<cfg-name>.";
        leaf onu-template-name {
          type string;
        }
        leaf cfg-name {
          type spt:pon-string64nz;
          description
            "Name of the service configuration parameter (e.g., 'CVID UNI').";
        }
        leaf value {
          type union {
            type uint32;
            type string {
              length "0..64";
            }
          }
          mandatory true;
          description
            "Service configuration parameter value.";
        }
        leaf value-type {
          type spt:service-config-value-type;
          must ". = 'int32' or . = 'string'";
          default "int32";
          description
            "Defines the data type for the 'value' attribute.";
        }
      }
    }
    container PON_ONU_TEMPLATE_UNI {
      description
        "PON_ONU_TEMPLATE_UNI table in ConfigDB.";
      list PON_ONU_TEMPLATE_UNI_LIST {
        key "onu-template-name port-id";
        description
          "Configurations for the UNI ports on the ONU.
           ConfigDB key: PON_ONU_TEMPLATE_UNI|<onu-template-name>|<port-id>.";
        leaf onu-template-name {
          type string;
        }
        leaf port-id {
          type string {
            pattern 'UNI-ETH\s[1-9][0-9]?';
          }
          description
            "Identifier for this UNI port.";
        }
        leaf duplex {
          type spt:duplex-mode;
          default "auto";
          description
            "Sets the duplex for the Ethernet port.";
        }
        leaf enable {
          type boolean;
          description
            "Admin enable or disable for the UNI port.";
        }
        leaf max-frame-size {
          type uint32;
          default "2000";
          description
            "Set the maximum frame size on UNI port.";
        }
        leaf poe {
          type boolean;
          default "false";
          description
            "Enable Power over Ethernet (PoE) on the UNI port.";
          reference
            "ITU-T G.988 clause 9.5.1 Physical path termination point Ethernet UNI, Power control";
        }
        leaf speed {
          type spt:speed-mode;
          default "auto";
          description
            "Sets the speed of the Ethernet port.";
        }
      }
    }
    container PON_ONU {
      description
        "PON_ONU table in ConfigDB.";
      list PON_ONU_LIST {
        key "onu-name";
        description
          "List of ONUs.
           ConfigDB key: PON_ONU|<onu-name>.";
        leaf onu-name {
          description
            "Name identifier to reference this ONU device.";
          type string {
            length "0..256";
          }
        }
        leaf device-id {
          mandatory true;
          description
            "ONU device identifier (XGS-PON: Vendor + SSN, or 'Default')";
          type string {
            pattern "([a-zA-Z]{4}[0-9a-fA-F]{8})|(Default)";
          }
        }
        leaf template-ref {
          type string;
          description
            "Reference to the ONU template to use for this ONU.";
        }
        leaf vlan-id {
          type uint16 {
            range "0..4095";
          }
          description
            "VID service configuration.";
        }
        leaf fw-bank-ptr {
          type uint16 {
            range "0..1|65535";
          }
          default "65535";
          description
            "Current Firmware bank pointer. A value of '65535' disables ONU firmware upgrade.";
        }
        leaf realtime-stats {
          type boolean;
          default "false";
          description
            "Enables the ONU state files to show all statistics on every cycle.";
        }
        leaf service-config {
          type string {
            length "0..64";
          }
          units "'Disabled' or 'Add CTag' or 'Unmodified' or <Service Config Name>";
          default "Disabled";
          description
            "ONU Service Configuration has 3 generic built-in modes and the ability to load a service configuration from the database.
             XGS supports all 3 configurations and service configuration files.
            ";
        }
        leaf service-config-omci-stats {
          type boolean;
          default "false";
          description
            "When set to true, no OMCI PM MEs will be automatically configured by the Controller.
             The PM MEs need to be specified in the ONU's SRV-CONFIG file.";
        }
        leaf fw-upgrade-backoff-delay {
          type uint32 {
            range "1..10";
          }
          units "seconds";
          default "5";
          description
            "Time to wait before retransmitting a window.";
        }
        leaf fw-upgrade-backoff-divisor {
          type uint32 {
            range "1..2";
          }
          default "2";
          description
            "Controls the size of the send window during retransmissions. A value of '2' reduces
             the send window size by half for each retransmission. A value of '1' disables the backoff.";
        }
        leaf fw-upgrade-download-format {
          type spt:fw-download-format;
          default "baseline-omci";
          description
            "The format of OMCI the PON Controller will use to upgrade the ONU, regardless of the OMCC Version it reported.";
        }
        leaf fw-upgrade-end-download-timeout {
          type uint32 {
            range "0..600";
          }
          units "seconds";
          default "0";
          description
            "Time to wait for the final acknowledgement during firmware upgrade. Increase the value
             to allow the ONU additional time to write the firmware image to flash. The PON Controller
             automatically calculates the end-download-timeout when set to a value of zero.
            ";
        }
        leaf fw-upgrade-maximum-retries {
          type uint32 {
            range "1..10";
          }
          default "4";
          description
            "Maximum number of times a window is retransmitted before terminating the ONU
             firmware upgrade and reporting an error.
            ";
        }
        leaf fw-upgrade-maximum-window-size {
          type uint32 {
            range "16..256";
          }
          units "bytes";
          default "64";
          description
            "The maximum send window sized used for transfering firmware to the ONU.";
        }
        leaf fw-upgrade-response-timeout {
          type uint32 {
            range "3..120";
          }
          units "seconds";
          default "3";
          description
            "The time in seconds to wait for an acknowledgement from the ONU during firmware upgrade.";
        }
      }
    }
    container PON_ONU_OLT_SERVICE {
      description
        "PON_ONU_OLT_SERVICE table in ConfigDB.";
      list PON_ONU_OLT_SERVICE_LIST {
        key "onu-name olt-service-id";
        description
          "OLT Configuration for the services. 0 to 7 services can be configured. A service is an XGEM Port ID/Alloc ID in XGS-PON.
           ConfigDB key: PON_ONU_OLT_SERVICE|<onu-name>|<olt-service-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU/sp:PON_ONU_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_LIST.";
        }
        leaf olt-service-id {
          type uint32 {
            range "0..7";
          }
          description
            "OLT Service Port number.";
        }
        leaf downstream-qos-map {
          type string {
            length "0..64";
          }
          default "";
          description
            "Reference to a Downstream QoS Map. Used with multiple XGem configurations.";
        }
        leaf enable {
          type boolean;
          default "false";
          description
            "True to enable this service port.  False to disable it.";
        }
        leaf learning-limit {
          type uint16 {
            range "0..2046";
          }
          default "2046";
          description
            "Dynamic MAC learning table size limit for this service port. A value of '0' disables MAC Learning for this service.";
        }
        leaf sla-profile {
          type string {
            length "0..64";
          }
          default "Max";
          description
            "Service level agreements for the service flow.";
        }
        leaf tcont-service-ref {
          type string {
            pattern "none|[0-7]";
          }
          description
            "none - OLT Service Port operates as a TCONT + XGem Port.
             TCONT OLT Service Port reference used to configure multiple XGem Ports for
             a single TCONT. When the value is set to a 'none', this OLT Service port operates as a
             TCONT + XGem Port. When the value references another OLT Service Port 0..7, this
             OLT Service port operates as an XGem Port only. When operating as an XGem only, this value
             must reference another OLT Service Port operating in TCONT + XGem mode.
            ";
        }
        max-elements 8;
        ordered-by system;
      }
    }
    container PON_ONU_OLT_SERVICE_NETWORK {
      description
        "PON_ONU_OLT_SERVICE_NETWORK table in ConfigDB.";
      list PON_ONU_OLT_SERVICE_NETWORK_LIST {
        key "onu-name olt-service-id vlan-id";
        description
          "List of VLAN network(s) (NNI and PON) through the service flow. VLAN Networks are defined by the SVLAN VID and two CVLAN VIDs.
           ConfigDB key: PON_ONU_OLT_SERVICE_NETWORK|<onu-name>|<olt-service-id>|<vlan-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU/sp:PON_ONU_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_LIST.";
        }
        leaf olt-service-id {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_OLT_SERVICE/sp:PON_ONU_OLT_SERVICE_LIST/sp:olt-service-id";
          }
          description
            "References PON_ONU_OLT_SERVICE_LIST.";
        }
        leaf network-id {
          type uint16 {
            range "0..999";
          }
          description
            "Index for this entry.";
        }
        leaf vlan-id {
          type uint16 {
            range "0..4095";
          }
          description
            "VID for service configuration.";
        }
        max-elements 1000;
        ordered-by system;
      }
    }
    container PON_ONU_SERVICE_CONFIG_VALUE {
      description
        "PON_ONU_SERVICE_CONFIG_VALUE table in ConfigDB.";
      list PON_ONU_SERVICE_CONFIG_VALUE_LIST {
        key "onu-name cfg-name";
        description
          "Service configuration file parameter 'onu-name' = 'value' pairs.
           ConfigDB key: PON_ONU_SERVICE_CONFIG_VALUE|<onu-name>|<cfg-name>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU/sp:PON_ONU_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_LIST.";
        }
        leaf cfg-name {
          type spt:pon-string64nz;
          description
            "Name of the service configuration parameter (e.g., 'CVID UNI').";
        }
        leaf value {
          type union {
            type uint32;
            type string {
              length "0..64";
            }
          }
          mandatory true;
          description
            "Service configuration parameter value.";
        }
        leaf value-type {
          type spt:service-config-value-type;
          must ". = 'int32' or . = 'string'";
          default "int32";
          description
            "Defines the data type for the 'value' attribute.";
        }
      }
    }
    container PON_ONU_UNI {
      description
        "PON_ONU_UNI table in ConfigDB.";
      list PON_ONU_UNI_LIST {
        key "onu-name port-id";
        description
          "Configurations for the UNI ports on the ONU.
           ConfigDB key: PON_ONU_UNI|<onu-name>|<port-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU/sp:PON_ONU_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_LIST.";
        }
        leaf port-id {
          type string {
            pattern 'UNI-ETH\s[1-9][0-9]?';
          }
          description
            "Identifier for this UNI port.";
        }
        leaf duplex {
          type spt:duplex-mode;
          default "auto";
          description
            "Sets the duplex for the Ethernet port.";
        }
        leaf enable {
          type boolean;
          description
            "Admin enable or disable for the UNI port.";
        }
        leaf max-frame-size {
          type uint32;
          default "2000";
          description
            "Set the maximum frame size on UNI port.";
        }
        leaf poe {
          type boolean;
          default "false";
          description
            "Enable Power over Ethernet (PoE) on the UNI port.";
          reference
            "ITU-T G.988 clause 9.5.1 Physical path termination point Ethernet UNI, Power control";
        }
        leaf speed {
          type spt:speed-mode;
          default "auto";
          description
            "Sets the speed of the Ethernet port.";
        }
      }
    }
    container PON_ONU_FW_BANK_FILE {
      description
        "PON_ONU_FW_BANK_FILE table in ConfigDB.";
      list PON_ONU_FW_BANK_FILE_LIST {
        key "onu-name bank-id";
        description
          "XGS-PON: firmware source filenames for bank 0 (1st in list) and bank 1 if version doesn't match.

           ConfigDB key: PON_ONU_FW_BANK_FILE|<onu-name>|<bank-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU/sp:PON_ONU_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_LIST.";
        }
        leaf bank-id {
          type uint8 {
            range "0..1";
          }
          description
            "Index for this entry.";
        }
        leaf file {
          type string {
            length "0..64";
          }
          description
            "Name of the firmware file.";
        }
        leaf version {
          type string {
            length "0..64";
          }
          description
            "Version.";
        }
        max-elements 2;
        ordered-by system;
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_HEADER {
      description
        "Service configuration header. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_HEADER.";
      list PON_SERVICE_CONFIG_PROFILE_HEADER_LIST {
        key "name";
        description
          "PON_SERVICE_CONFIG_PROFILE_HEADER configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_HEADER|<name>.";
        leaf name {
          type string;
          description
            "ONU vendor name.";
        }
        leaf title {
          type string;
          description
            "Description for this service configuration.";
        }
        leaf version {
          type string;
          description
            "Capability of configuration file format.";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_HEADER_COMPATIBILITY_VENDOR_MODEL {
      description
        "PON_SERVICE_CONFIG_PROFILE_HEADER_COMPATIBILITY_VENDOR_MODEL table in ConfigDB.";
      list PON_SERVICE_CONFIG_PROFILE_HEADER_COMPATIBILITY_VENDOR_MODEL_LIST {
        key "vendor-id name";
        description
          "PON_SERVICE_CONFIG_PROFILE_HEADER_COMPATIBILITY_VENDOR_MODEL configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_HEADER_COMPATIBILITY_VENDOR_MODEL|<vendor-id>|<name>.";
        leaf vendor-id {
          type string;
        }
        leaf name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_SERVICE_CONFIG_PROFILE_HEADER/sp:PON_SERVICE_CONFIG_PROFILE_HEADER_LIST/sp:name";
          }
          description
            "References PON_SERVICE_CONFIG_PROFILE_HEADER_LIST.";
        }
        leaf-list model {
          type string;
          description
            "ONU model number.";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_HEADER_INPUTS_EXT_INPUT {
      description
        "PON_SERVICE_CONFIG_PROFILE_HEADER_INPUTS_EXT_INPUT table in ConfigDB.";
      list PON_SERVICE_CONFIG_PROFILE_HEADER_INPUTS_EXT_INPUT_LIST {
        key "name db-ref";
        description
          "PON_SERVICE_CONFIG_PROFILE_HEADER_INPUTS_EXT_INPUT configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_HEADER_INPUTS_EXT_INPUT|<name>|<db-ref>.";
        leaf name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_SERVICE_CONFIG_PROFILE_HEADER/sp:PON_SERVICE_CONFIG_PROFILE_HEADER_LIST/sp:name";
          }
          description
            "References PON_SERVICE_CONFIG_PROFILE_HEADER_LIST.";
        }
        leaf db-ref {
          type omci-types:omci-db-ref;
          description
            "Path referencing a specific collection and field in the database.";
        }
        leaf type {
          type omci-types:header-input-type;
          description
            "Input data type.";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_ANI_G {
      description
        "ANI-G, Class Value 263. This ME organizes data associated with each access network interface supported by a G-PON ONU. The ONU automatically creates one instance of this ME for each PON physical port. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_ANI_G.";
      reference
        "G.988, 9.2.1, ANI-G";
      list PON_SERVICE_CONFIG_PROFILE_ANI_G_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_ANI_G_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_ANI_G|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
          description
            "Service configuration profile identifier that scopes ANI-G managed entities.";
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID for ANI-G. The value indicates the physical position of the PON interface.";
        }
        leaf gem-block-length {
          type omci-types:omci-uint16;
          description
            "Queue occupancy reporting granularity for DBA, expressed in bytes.";
        }
        leaf sf-threshold {
          type omci-types:omci-uint8;
          description
            "Signal fail BER threshold exponent y, where threshold is 10^(-y).";
        }
        leaf sd-threshold {
          type omci-types:omci-uint8;
          description
            "Signal degrade BER threshold exponent x, where threshold is 10^(-x).";
        }
        leaf arc {
          type omci-types:omci-uint8;
          description
            "Alarm-reporting control (ARC) value.";
        }
        leaf arc-interval {
          type omci-types:omci-uint8;
          description
            "Alarm-reporting control interval.";
        }
        leaf lower-optical-threshold {
          type omci-types:omci-uint8;
          description
            "Lower received optical power threshold used for low-power alarm detection.";
        }
        leaf upper-optical-threshold {
          type omci-types:omci-uint8;
          description
            "Upper received optical power threshold used for high-power alarm detection.";
        }
        leaf lower-transmit-power-threshold {
          type omci-types:omci-uint8;
          description
            "Lower transmit optical launch power threshold for low transmit power alarm.";
        }
        leaf upper-transmit-power-threshold {
          type omci-types:omci-uint8;
          description
            "Upper transmit optical launch power threshold for high transmit power alarm.";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_CARDHOLDER {
      description
        "Cardholder, Class Value 5. This ME represents ONU slot/cardholder provisioning and expected equipment attributes for circuit pack realization. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_CARDHOLDER.";
      reference
        "G.988, 9.1.5, Cardholder";
      list PON_SERVICE_CONFIG_PROFILE_CARDHOLDER_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_CARDHOLDER_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_CARDHOLDER|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
          description
            "Service configuration profile identifier that scopes Cardholder managed entities.";
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID that uniquely identifies the Cardholder instance.";
        }
        leaf expected-plugin-unit-type {
          type omci-types:omci-uint8;
          description
            "Provisioned expected circuit pack type for the slot.";
        }
        leaf expected-port-count {
          type omci-types:omci-uint8;
          description
            "Expected number of ports in the circuit pack.";
        }
        leaf expected-equipment-id {
          type omci-types:omci-string;
          description
            "Expected specific equipment identifier for the circuit pack.";
        }
        leaf invoke-protection-switch {
          type omci-types:omci-uint8;
          description
            "Protection switching control value used by OLT to control protection state.";
        }
        leaf arc {
          type omci-types:omci-uint8;
          description
            "Alarm-reporting control (ARC) value.";
        }
        leaf arc-interval {
          type omci-types:omci-uint8;
          description
            "Alarm-reporting control interval.";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_CIRCUIT_PACK {
      description
        "Circuit pack, Class Value 6. This ME models a real or virtual circuit pack that is equipped in a real or virtual ONU slot. For ONUs with integrated interfaces, this ME may be used to distinguish available types of interfaces (the port-mapping package is another way). For ONUs with integrated interfaces, the ONU automatically creates an instance of this ME for each instance of the virtual cardholder ME. The ONU also creates an instance of this ME when the OLT provisions the cardholder to expect a circuit pack, i.e., when the OLT sets the expected plug-in unit type or equipment ID of the cardholder to a circuit pack type, as defined in Table 9.1.5-1. The ONU also creates an instance of this ME when a circuit pack is installed in a cardholder whose expected plug-in unit type is 255= plug-and- play, and whose equipment ID is not provisioned. Finally, when the cardholder is provisioned for plug-and-play, an instance of this ME can be created at the request of the OLT. The ONU deletes an instance of this ME when the OLT de-provisions the circuit pack (i.e., when the OLT sets the expected plug-in unit type or equipment ID of the cardholder to 0= no LIM). The ONU also deletes an instance of this ME on request of the OLT if the expected plug-in unit type attribute of the corresponding cardholder is equal to 255, plug-and-play, and the expected equipment ID is blank (a string of all spaces). ONUs with integrated interfaces do not delete circuit pack instances. NOTE Creation and deletion by the OLT is retained for backward compatibility. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_CIRCUIT_PACK.";
      reference
        "G.988, 9.1.6, Circuit pack";
      list PON_SERVICE_CONFIG_PROFILE_CIRCUIT_PACK_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_CIRCUIT_PACK_MANAGED_ENTITY configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_CIRCUIT_PACK|<service-config-profile-name>|<managed-entity-id>.";
        leaf service-config-profile-name {
          type string;
          description
            "Service configuration profile identifier that scopes Circuit pack managed entities.";
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID that uniquely identifies the Circuit pack instance.";
        }
        leaf administrative-state {
          type omci-types:omci-uint8;
          description
            "Administrative state of this circuit pack instance (for example lock or unlock).";
        }
        leaf bridged-or-ip-ind {
          type omci-types:omci-uint8;
          description
            "Indicates whether an Ethernet interface is bridged, IP router based, or both.";
        }
        leaf card-configuration {
          type omci-types:omci-uint8;
          description
            "Configuration selector for configurable circuit pack variants.";
        }
        leaf power-sched-override {
          type omci-types:omci-uint32;
          description
            "Power sched override mask controlling ports excluded from power shedding.";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_ENHANCED_FEC_PM_HIST_DATA {
      description
        "Enhanced FEC performance monitoring history data, Class Value 453. This ME collects PM data associated with PON downstream FEC counters for XGS-PON and subsequent ITU-T PON systems. Instances of this ME are created and deleted by the OLT. For a complete discussion of generic PM architecture, refer to clause I.4. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_ENHANCED_FEC_PM_HIST_DATA.";
      reference
        "G.988, 9.2.22, Enhanced FEC performance monitoring history data";
      list PON_SERVICE_CONFIG_PROFILE_ENHANCED_FEC_PM_HIST_DATA_LIST {
        key "service-config-profile-name managed-entity-id";
        description
          "PON_SERVICE_CONFIG_PROFILE_OMCI_CLASS_ENHANCED_FEC_PM_HIST_DATA_MANAGED_ENTITY  configuration.
           ConfigDB key: PON_SERVICE_CONFIG_PROFILE_ENHANCED_FEC_PM_HIST_DATA|<service-config-profile-name>|<managed-entity-id>.";
