    container PON_OLT_STATISTICS_ACCUMULATING_PON_FLOODING_NNI_NETWORK {
      description
        "PON_OLT_STATISTICS_ACCUMULATING_PON_FLOODING_NNI_NETWORK table in CounterDB.";
      config false;
      list PON_OLT_STATISTICS_ACCUMULATING_PON_FLOODING_NNI_NETWORK_LIST {
        key "olt-name olt-id";
        description
          "List of VLAN Tags identifying the NNI Networks using this PON Flood ID.
           CounterDB key: PON_OLT_STATISTICS_ACCUMULATING_PON_FLOODING_NNI_NETWORK|<olt-name>|<olt-id>.";
        leaf olt-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF_STATE/sp:PON_OLT_INTF_STATE_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_STATE_LIST.";
        }
        leaf olt-id {
          type uint16;
          description
            "OLT PON Flood ID (GPON: Multicast XGEM Port ID).";
        }
        leaf-list vlan-tag {
          type string;
          units "S#.C#.C#";
          description
            "NNI Network VLAN tag stack in the format 'S#.C#.C#'.";
        }
      }
    }
    container PON_ONU_STATE {
      description
        "PON_ONU_STATE table in StateDB.";
      config false;
      list PON_ONU_STATE_LIST {
        key "onu-name";
        description
          "List of ONUs.
           StateDB key: PON_ONU_STATE|<onu-name>.";
        leaf onu-name {
          type string;
          description
            "Name identifier to reference this ONU device.";
        }
        leaf timestamp {
          type yang:date-and-time;
          description
            "The last update for this state file";
        }
        leaf onu-id {
          type uint16;
          description
            "ONU ID used on the PON";
        }
        leaf cvid {
          type uint16;
          description
            "VID for service configuration";
        }
        leaf equipment-id {
          type string;
          description
            "Equipment ID as reported by the ONU through G.988 ONU-G.";
        }
        leaf fw-bank-ptr {
          type uint16;
          description
            "Current value of the firmware bank pointer";
        }
        leaf fw-version {
          type string;
          description
            "Current firmware running on the ONU";
        }
        leaf hardware-version {
          type string;
          description
            "Hardware version reported by the ONU.";
        }
        leaf last-provisioning-time {
          type yang:date-and-time;
          description
            "The last time the Controller completed provisioning service for the ONU.";
        }
        leaf mac-address {
          type yang:mac-address;
          description
            "MAC Address for this ONU";
        }
        leaf manufacturer {
          type string;
          description
            "Manufacturer of the ONU";
        }
        leaf model {
          type string;
          description
            "Model name for the ONU";
        }
        leaf online-time {
          type yang:date-and-time;
          description
            "The last time the ONU successfully completed registration with the OLT.";
        }
        leaf realtime-stats {
          type boolean;
          description
            "Enables the ONU state files to show all statistics on every cycle.";
        }
        leaf registration-id {
          type string;
          description
            "ID used for this ONU during PLOAM registration.  This value is sometimes used to authenticate the ONU.";
        }
        leaf alloc-id-omcc {
          type uint16;
          description
            "ONU ID used on the PON";
        }
        leaf host-mac-address {
          type yang:mac-address;
          description
            "MAC Address of the IP Host running on this ONU.";
        }
        leaf laser-bias-current {
          type uint64;
          units "microamp";
          description
            "Current in microAmps. This is reported by the XGS ONU when an Optical Line Supervision Test is performed on the ONU";
        }
        leaf logical-id {
          type string;
          description
            "Logical ID programmed in XGS-PON ONU";
        }
        leaf logical-password {
          type string;
          description
            "Logical Password programmed in XGS-PON ONU";
        }
        leaf omci-txn-correlation-id {
          type uint16;
          description
            "Last OMCI transaction correlation identifier sent by the PON Controller to the ONU.";
        }
        leaf omcc-version {
          type yang:hex-string;
          description
            "This attribute identifies the version of the OMCC protocol being used by the ONU.";
        }
        leaf temperature {
          type decimal64 {
            fraction-digits 3;
          }
          units "degrees celsius";
          description
            "Temperature in degrees Celsius. This is reported by the XGS ONU when an Optical Line Supervision Test is performed on the ONU";
        }
        leaf uptime {
          type uint64;
          units "centiseconds";
          description
            "The time since the ONU module was reset.";
        }
        leaf voltage {
          type decimal64 {
            fraction-digits 3;
          }
          units "millivolt";
          description
            "Power Feed Voltage in milliVolts. This is reported by the XGS ONU when an Optical Line Supervision Test is performed on the ONU";
        }
        leaf registration-id-hex {
          type yang:hex-string;
          description
            "72-character (36-byte) hex-string Registration ID for this ONU.";
        }
        leaf serial-number {
          type string;
          description
            "ONU serial number";
        }
        leaf service-config {
          type string;
          description
            "Current ONU service configuration";
        }
        leaf vendor {
          type string;
          description
            "ONU Vendor. This is normally the chip vendor for the ONU.";
        }
        leaf fw-upgrade-backoff-delay {
          type uint32;
          units "seconds";
          description
            "Time to wait before retransmitting an window.";
        }
        leaf fw-upgrade-backoff-divisor {
          type uint32;
          description
            "Controls the size of the send window during retransmissions. A value of '2' reduces
             the send window size by half for each retransmission. A value of '1' disables the backoff.";
        }
        leaf fw-upgrade-download-format {
          type spt:fw-download-format;
          description
            "The format of OMCI the PON Controller will use to upgrade the ONU, regardless of the OMCC Version it reported.";
        }
        leaf fw-upgrade-end-download-timeout {
          type uint32;
          units "seconds";
          description
            "Time to wait for the final acknowledgement during firmware upgrade. Increase the value
             to allow the ONU additional time to write the firmware image to flash. The PON Controller
             automatically calculates the end-download-timeout when set to a value of zero.
            ";
        }
        leaf fw-upgrade-maximum-retries {
          type uint32;
          description
            "Maximum number of times a window is retransmitted before terminating the ONU
             firmware upgrade and reporting an error.
            ";
        }
        leaf fw-upgrade-maximum-window-size {
          type uint32;
          units "bytes";
          description
            "The maximum send window sized used for transfering firmware to the ONU.";
        }
        leaf fw-upgrade-response-timeout {
          type uint32;
          units "seconds";
          description
            "The time in seconds to wait for an acknowledgement from the ONU during firmware upgrade.";
        }
        leaf ssh-server-state {
          type string;
          description
            "The last reported SSH Server status.";
        }
        leaf registration-disallowed {
          type boolean;
          description
            "When true, the OLT is not allowing the ONU to register because the OLT is not specified in the ONU configuration file.  This value is only true for Disallowed Admin and not for Disallowed Error.";
        }
        leaf bank {
          type uint16;
          description
            "Last firmware bank number (software download ME ID) firmware was downloaded to.";
        }
        leaf current-window {
          type uint8;
          description
            "Current window size for the software download.";
        }
        leaf fx-code {
          type string;
          description
            "OMCI Software Download error code as defined in G.988.";
        }
        leaf file {
          type string;
          description
            "Name of the file to download.";
        }
        leaf negotiated-window {
          type uint8;
          description
            "Initial negotiated window size for the software download.";
        }
        leaf progress {
          type uint8;
          units "Percent complete 0..100";
          description
            "Name of the file to download.";
        }
        leaf retries {
          type uint8;
          description
            "Number of retries during the software download.";
        }
        leaf sent-blocks {
          type uint32;
          description
            "Current number of blocks sent for the software download.";
        }
        leaf status {
          type string;
          description
            "Software download status (Downloading, Success, Failed).";
        }
        leaf total-blocks {
          type uint32;
          description
            "Total number of blocks for the software download.";
        }
        leaf upgrade-duration {
          type string;
          description
            "Length of time in hours, minutes, and seconds for the ONU upgrade to complete.";
        }
        leaf upgrade-time {
          type yang:date-and-time;
          description
            "Timestamp reporting time the ONU was upgraded.";
        }
        leaf aborted {
          type boolean;
          description
            "When true, the ONU firmware upgrade has been aborted.";
        }
        leaf failures {
          type uint32;
          description
            "Failure count from the latest firmware upgrade on this ONU.";
        }
        leaf version-mismatches {
          type uint32;
          description
            "Version mismatch count from the latest firmware upgrade on this ONU.";
        }
      }
    }
    container PON_ONU_STATISTICS_BINNED {
      description
        "PON_ONU_STATISTICS_BINNED table in StateDB.";
      config false;
      list PON_ONU_STATISTICS_BINNED_LIST {
        key "onu-name onu-stats-id";
        description
          "Realtime statistics for the ONU.  These are the values of the statistics after a
           gather to the statistic file.  The ONU statistics vary based on ONU configuration.

           StateDB key: PON_ONU_STATISTICS_BINNED|<onu-name>|<onu-stats-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf olt-pon-rx-optical-level {
          type decimal64 {
            fraction-digits 3;
          }
          units "dBm";
          description
            "Receive optical level.";
        }
        leaf olt-pon-tx-optical-level {
          type decimal64 {
            fraction-digits 3;
          }
          units "dBm";
          description
            "Transmit optical level.";
        }
        leaf olt-pon-rx-deregistrations {
          type uint64;
          description
            "Number of times the ONU has deregistered.";
        }
        leaf olt-pon-rx-registrations {
          type uint64;
          description
            "Number of times the ONU has completed registration.";
        }
        leaf olt-pon-fiber-distance {
          type decimal64 {
            fraction-digits 3;
          }
          units "kilometers";
          description
            "Reports the ONU fiber distance in kilometers.";
        }
        leaf olt-pon-equalization-delay {
          type uint64;
          units "upstream-slots(12.8ns)";
          description
            "Equalization delay assigned by the OLT to an ONU
             to ensure that the ONU's transmissions are aligned on a common
             upstream time reference.";
          reference
            "ITU-T G.9807.1 clause C.13.1";
        }
        leaf olt-pon-round-trip-time {
          type uint64;
          units "TQ(16ns)";
          description
            "Calculated Round Trip Time (RTT) between the OLT and ONU.";
          reference
            "ITU-T G984.3";
        }
        leaf olt-pon-one-way-delay {
          type uint64;
          units "microseconds";
          description
            "One way delay reported for an ONU.";
        }
        leaf olt-pon-rx-acc-fec-bytes {
          type uint64;
          description
            "Receive Accumulated FEC Bytes";
        }
        leaf olt-pon-rx-acc-fec-correct-bytes {
          type uint64;
          description
            "Receive Accumulated FEC Corrected Bytes";
        }
        leaf olt-pon-rx-acc-fec-error-bytes {
          type uint64;
          description
            "Receive Accumulated FEC Errored Bytes";
        }
        leaf olt-pon-rx-pre-fec-ber {
          type string;
          description
            "Receive Pre-FEC Bit Error Rate represented in scientific notation.";
        }
        leaf olt-pon-rx-post-fec-ber {
          type string;
          description
            "Receive Post-FEC Bit Error Rate represented in scientific notation.";
        }
        leaf onu-stats-id {
          type yang:date-and-time;
          description
            "Timestamp identifying the statistics collection period.";
        }
        leaf timestamp {
          type yang:date-and-time;
          description
            "Timestamp when the statistics were collected.";
        }
      }
    }
    container PON_ONU_OLT_SERVICE_STATE {
      description
        "PON_ONU_OLT_SERVICE_STATE table in StateDB.";
      config false;
      list PON_ONU_OLT_SERVICE_STATE_LIST {
        key "onu-name olt-service-id";
        description
          "The OLT provisioned services for this ONU. An entry exists for each service on the OLT for this ONU.
           StateDB key: PON_ONU_OLT_SERVICE_STATE|<onu-name>|<olt-service-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf olt-service-id {
          type uint32;
          description
            "OLT Service Port number.";
        }
        leaf enable {
          type boolean;
          description
            "If the service port is currently enabled or disabled.";
        }
        leaf learning-limit {
          type uint16;
          description
            "Dynamic MAC learning table size limit for this service port. A value of '0' indicates that MAC Learning is disabled for this service.";
        }
        leaf tcont-service-ref {
          type string {
            pattern "none|[0-7]";
          }
          description
            "none - OLT Service Port operates as a TCONT + XGem Port.
             Reference to a OLT Service Port operating in TCONT + XGem mode. A blank
             value indicates this OLT Service Port is operating as TCONT + XGem. Otherwise, a non-empty
             value indicates this OLT Serice Port is operating in XGem-only mode, where the value
             references another OLT Service Port that serves as the TCONT for this XGem Port.
            ";
        }
        leaf unicast-id {
          type uint16;
          description
            "XGEM Port ID for unicast traffic on this service port.";
        }
        leaf upstream-priority-treatment {
          type enumeration {
            enum copy {
              description
                "Copy the priority bits from the inner C-Tag for OLT configurations that add an
                 outer VLAN tag. Copy the priority bits from the original VLAN tag to the new VLAN tag
                 for OLT configurations that translate an outer VLAN tag.
                ";
            }
            enum set {
              description
                "Set the priority to a specific value 0..7 in VLAN tags that are added or
                 translated by the OLT. The priority value is specified by the upstream-priority-value
                 attribute.
                ";
            }
          }
          description
            "Treatment of priority (CoS) bits in VLAN tags added or translated by the OLT for
             frames received upstream from the ONU.";
        }
        leaf upstream-priority-value {
          type uint8;
          description
            "VLAN tag priority value to insert in frames when the upstream-priority-treatment
             attribute is 'set'.
            ";
        }
        leaf sla-downstream-guaranteed-rate {
          type uint32;
          units "kbps";
          description
            "Guaranteed (high priority) rate in kbps.";
        }
        leaf sla-downstream-guaranteed-maximum-burst {
          type uint32;
          units "kBytes";
          description
            "Maximum burst size in Kilobytes. The guaranteed rate is enforced at this burst size.";
        }
        leaf sla-downstream-best-effort-rate {
          type uint32;
          units "kbps";
          description
            "Best Effort (low priority) rate in kbps.";
        }
        leaf sla-downstream-best-effort-maximum-burst {
          type uint32;
          units "kBytes";
          description
            "Maximum burst size in Kilobytes. The best effort rate is enforced at this burst size.";
        }
        leaf sla-upstream-fixed-rate {
          type uint32;
          units "kbps";
          description
            "Fixed grant rate in kbps. This is an unsolicited grant by the DBA regardless of need.";
        }
        leaf sla-upstream-guaranteed-rate {
          type uint32;
          units "kbps";
          description
            "Guaranteed (high priority) rate in kbps.";
        }
        leaf sla-upstream-guaranteed-maximum-burst {
          type uint32;
          units "kBytes";
          description
            "Maximum burst size in Kilobytes. The guaranteed rate is enforced at this burst size.";
        }
        leaf sla-upstream-priority {
          type uint8;
          description
            "Priority level for the guaranteed portion of the SLA.";
        }
        leaf sla-upstream-best-effort-rate {
          type uint32;
          units "kbps";
          description
            "Best Effort (low priority) rate in kbps.";
        }
        leaf sla-upstream-best-effort-maximum-burst {
          type uint32;
          units "kBytes";
          description
            "Maximum burst size in Kilobytes. The best effort rate is enforced at this burst size.";
        }
        leaf sla-upstream-best-effort-priority {
          type uint8;
          description
            "Priority level for the Best Effort portion of the SLA.";
        }
        leaf downstream-qos-map {
          type string;
          description
            "Name of the downstream QoS map applied to this OLT service port.";
        }
        ordered-by system;
      }
    }
    container PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_STATE {
      description
        "PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_STATE table in StateDB.";
      config false;
      list PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_STATE_LIST {
        key "onu-name olt-service-id";
        description
          "Downstream QoS Map
           StateDB key: PON_ONU_OLT_SERVICE_DOWNSTREAM_QOS_MAP_STATE|<onu-name>|<olt-service-id>.";
