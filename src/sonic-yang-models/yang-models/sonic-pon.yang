    container PON_OLT_PLUG_FW_UPGRADE_STATUS {
      description
        "PON_OLT_PLUG_FW_UPGRADE_STATUS table in StateDB.";
      config false;
      list PON_OLT_PLUG_FW_UPGRADE_STATUS_LIST {
        key "name";
        description
          "Firmware upgrade status. If a firmware upgrade is currently in-progress, the current
           status is reported. Otherwise, the status is reported for the last firmware upgrade performed
           for this OLT plug.

           StateDB key: PON_OLT_PLUG_FW_UPGRADE_STATUS|<name>.";
        leaf name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_PLUG_STATE/sp:PON_OLT_PLUG_STATE_LIST/sp:name";
          }
          description
            "References PON_OLT_PLUG_STATE_LIST.";
        }
        leaf bank {
          type uint16;
          description
            "Last firmware bank number (software download ME ID) firmware was downloaded to.";
        }
        leaf fx-code {
          type uint32;
          description
            "OLT plug Software Download error code.";
        }
        leaf file {
          type string;
          description
            "Name of the file to download.";
        }
        leaf status {
          type string;
          description
            "Software download status (Downloading, Success, Failed).";
        }
        leaf upgrade-duration {
          type string;
          description
            "Length of time in hours, minutes, and seconds for the OLT plug upgrade to complete.";
        }
        leaf upgrade-time {
          type yang:date-and-time;
          description
            "Timestamp reporting time the OLT plug was upgraded.";
        }
      }
    }
