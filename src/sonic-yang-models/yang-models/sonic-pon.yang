        key "onu-name onu-stats-id me-id";
        description
          "GPON: Counters associated with gal ethernet messages.
           StateDB key: PON_ONU_STATISTICS_BINNED_ONU_GAL_ETHERNET_PM|<onu-name>|<onu-stats-id>|<me-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf onu-stats-id {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATISTICS_BINNED/sp:PON_ONU_STATISTICS_BINNED_LIST/sp:onu-stats-id";
          }
          description
            "References PON_ONU_STATISTICS_BINNED_LIST.";
        }
        leaf me-id {
          type uint16;
          description
            "Performance management ME ID.";
        }
        leaf discarded-downstream-frames {
          type uint64;
          description
            "Counts the number of downstream GEM frames discarded for any reason";
        }
        leaf discarded-upstream-frames {
          type uint64;
          description
            "Counts the number of upstream frames discarded prior to GEM encapsulation (due to congestion)";
        }
        leaf interval-end-time {
          type uint64;
          description
            "Identifies the most recently finished 15 min interval";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Points to an instance of the threshold data 1 ME that contains PM threshold values";
        }
      }
    }
    container PON_ONU_STATISTICS_BINNED_ONU_GEM_PORT_NETWORK_CTP_PM {
      description
        "PON_ONU_STATISTICS_BINNED_ONU_GEM_PORT_NETWORK_CTP_PM table in StateDB.";
      config false;
      list PON_ONU_STATISTICS_BINNED_ONU_GEM_PORT_NETWORK_CTP_PM_LIST {
        key "onu-name onu-stats-id me-id";
        description
          "GPON: Counters associated with gem port network ctp messages.
           StateDB key: PON_ONU_STATISTICS_BINNED_ONU_GEM_PORT_NETWORK_CTP_PM|<onu-name>|<onu-stats-id>|<me-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf onu-stats-id {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATISTICS_BINNED/sp:PON_ONU_STATISTICS_BINNED_LIST/sp:onu-stats-id";
          }
          description
            "References PON_ONU_STATISTICS_BINNED_LIST.";
        }
        leaf me-id {
          type uint16;
          description
            "Performance management ME ID.";
        }
        leaf encryption-key-errors {
          type uint64;
          description
            "Counts GEM frames with erroneous encryption key indexes. If the GEM port is not encrypted,
             this attribute counts any frame with a key index not equal to 0. If the GEM port is encrypted,
             this attribute counts any frame whose key index specifies a key that is not known to the ONU.
            ";
        }
        leaf interval-end-time {
          type uint64;
          description
            "Identifies the most recently finished 15 min interval";
        }
        leaf received-gem-frames {
          type uint64;
          description
            "Counts GEM frames received correctly on the monitored GEM port. A correctly received GEM frame
             is one that does not contain uncorrectable errors and has a valid header error check (HEC).
            ";
        }
        leaf received-payload-bytes {
          type uint64;
          description
            "Counts user payload bytes received on the monitored GEM port";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Points to an instance of the threshold data 1 ME that contains PM threshold values";
        }
        leaf transmitted-gem-frames {
          type uint64;
          description
            "Counts GEM frames transmitted on the monitored GEM port";
        }
        leaf transmitted-payload-bytes {
          type uint64;
          description
            "Counts user payload bytes transmitted on the monitored GEM port";
        }
      }
    }
