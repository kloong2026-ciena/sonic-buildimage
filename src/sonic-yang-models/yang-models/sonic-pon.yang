        leaf service-config-profile-name {
          type string;
        }
        leaf managed-entity-id {
          type omci-types:omci-uint16;
          description
            "Managed entity ID: This attribute uniquely identifies each instance of this ME. Through an identical ID, this ME is implicitly linked to an instance of a MAC bridge port configuration data. (R, set-by-create) (mandatory) (2bytes)";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Threshold data 1/2 ID: This attribute points to an instance of the threshold data 1 ME that contains PM threshold values. Since no threshold value attribute number exceeds 7, a threshold data 2 ME is optional. (R,W, set-by-create) (mandatory) (2bytes)";
        }
      }
    }
    container PON_SERVICE_CONFIG_PROFILE_ETHERNET_PERF_MON_HIST_DATA {
      description
        "Ethernet performance monitoring history data, Class Value 24. This ME collects some of the PM data for a physical Ethernet interface. Instances of this ME are created and deleted by the OLT. For a complete discussion of generic PM architecture, refer to clause I.4. ConfigDB table: PON_SERVICE_CONFIG_PROFILE_ETHERNET_PERF_MON_HIST_DATA.";
      reference
        "G.988, 9.5.2, Ethernet performance monitoring history data";
      list PON_SERVICE_CONFIG_PROFILE_ETHERNET_PERF_MON_HIST_DATA_LIST {
