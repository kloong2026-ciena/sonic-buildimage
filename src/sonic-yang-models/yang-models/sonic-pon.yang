            "Counts GEM frames with erroneous encryption key indexes. If the GEM port is not encrypted,
             this attribute counts any frame with a key index not equal to 0. If the GEM port is encrypted,
             this attribute counts any frame whose key index specifies a key that is not known to the ONU.
            ";
        }
        leaf interval-end-time {
          type uint64;
          description
            "Identifies the most recently finished 15 min interval";
        }
        leaf received-gem-frames {
          type uint64;
          description
            "Counts GEM frames received correctly on the monitored GEM port. A correctly received GEM frame
             is one that does not contain uncorrectable errors and has a valid header error check (HEC).
            ";
        }
        leaf received-payload-bytes {
          type uint64;
          description
            "Counts user payload bytes received on the monitored GEM port";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Points to an instance of the threshold data 1 ME that contains PM threshold values";
        }
        leaf transmitted-gem-frames {
          type uint64;
          description
            "Counts GEM frames transmitted on the monitored GEM port";
        }
        leaf transmitted-payload-bytes {
          type uint64;
          description
            "Counts user payload bytes transmitted on the monitored GEM port";
        }
      }
    }
    container PON_ONU_STATISTICS_STREAMING_ONU_ENHANCED_TC_PM {
      description
        "PON_ONU_STATISTICS_STREAMING_ONU_ENHANCED_TC_PM table in StateDB.";
      config false;
      list PON_ONU_STATISTICS_STREAMING_ONU_ENHANCED_TC_PM_LIST {
        key "onu-name onu-id";
        description
          "GPON: Enhanced TC statistics reported by ONU.
           StateDB key: PON_ONU_STATISTICS_STREAMING_ONU_ENHANCED_TC_PM|<onu-name>|<onu-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf onu-id {
          type uint16;
          description
            "ME Identifier for this TC.";
        }
        leaf lods-event-count {
          type uint64;
          description
            "Counts the number of state transitions from O5.1 to O6";
        }
        leaf lods-event-restored-count {
          type uint64;
          description
            "Counts the number of LODS cleared events";
        }
        leaf fragment-xgem-frames {
          type uint64;
          description
            "Counts the number of XGEM frames that represent fragmented SDUs, as indicated by the LF bit = 0";
        }
        leaf interval-end-time {
          type uint64;
          description
            "Identifies the most recently finished 15 min interval";
        }
        leaf onu-reactivation-by-lods-events {
          type uint64;
          description
            "Counts the number of LODS events resulting in ONU reactivation without synchronization being reacquired";
        }
        leaf psbd-hec-error-count {
          type uint64;
          description
            "Counts HEC errors in any of the fields of the downstream physical sync block";
        }
        leaf received-bytes-in-nonidle-xgem-frames {
          type uint64;
          description
            "Counts the number of received bytes in non-idle XGEM frames";
        }
        leaf transmitted-bytes-in-nonidle-xgem-frames {
          type uint64;
          description
            "Counts the number of transmitted bytes in non-idle XGEM frames";
        }
        leaf transmitted-xgem-frames {
          type uint64;
          description
            "Counts the number of non-idle XGEM frames transmitted. If an SDU is fragmented, each fragment is an XGEM frame and is counted as such.";
        }
        leaf unknown-profile-count {
          type uint64;
          description
            "Counts the number of grants received whose specified profile was not known to the ONU";
        }
        leaf xgem-hec-lost-words-count {
          type uint64;
          description
            "Counts the number of 4 byte words lost because of an XGEM frame HEC error. In general, all XGTC
             payload following the error is lost, until the next PSBd event.
            ";
        }
        leaf xgem-key-errors {
          type uint64;
          description
            "Counts the number of downstream XGEM frames received with an invalid key specification";
        }
        leaf xgem-hec-error-count {
          type uint64;
          description
            "Counts the number of instances of an XGEM frame HEC error";
        }
        leaf xgtc-hec-error-count {
          type uint64;
          description
            "Counts HEC errors detected in the XGTC header";
        }
        leaf threshold-data-64-bit-id {
          type uint64;
          description
            "Points to an instance of the threshold data 1 ME that contains PM threshold values";
        }
      }
    }
    container PON_ONU_STATISTICS_STREAMING_ONU_XG_PON_DOWNSTREAM_MGMT_PM {
      description
        "PON_ONU_STATISTICS_STREAMING_ONU_XG_PON_DOWNSTREAM_MGMT_PM table in StateDB.";
      config false;
      list PON_ONU_STATISTICS_STREAMING_ONU_XG_PON_DOWNSTREAM_MGMT_PM_LIST {
        key "onu-name onu-id";
        description
          "GPON: Counters associated with downstream PLOAM and OMCI messages.
           StateDB key: PON_ONU_STATISTICS_STREAMING_ONU_XG_PON_DOWNSTREAM_MGMT_PM|<onu-name>|<onu-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf onu-id {
          type uint16;
          description
            "Performance management ME ID.";
        }
        leaf interval-end-time {
          type uint64;
          description
            "Identifies the most recently finished 15 min interval.";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Points to an instance of the threshold data 1 ME that contains PM threshold values.";
        }
        leaf ploam-mic-error-count {
          type uint64;
          description
            "Counts MIC errors detected in downstream PLOAM messages, either directed to this ONU or broadcast to all ONUs";
        }
        leaf downstream-ploam-message-count {
          type uint64;
          description
            "Counts PLOAM messages received, either directed to this ONU or broadcast to all ONUs";
        }
        leaf profile-messages-received {
          type uint64;
          description
            "Counts the number of profile messages received, either directed to this ONU or broadcast to all ONUs.";
        }
        leaf ranging-time-messages-received {
          type uint64;
          description
            "Counts the number of ranging_time messages received, either directed to this ONU or broadcast to all ONUs.";
        }
        leaf deactivate-onu-id-messages-received {
          type uint64;
          description
            "Counts the number of deactivate_ONU-ID messages received, either directed to this ONU or broadcast to all ONUs";
        }
        leaf disable-serial-number-messages-received {
          type uint64;
          description
            "Counts the number of disable_serial_number messages received, whose serial number specified this ONU";
        }
        leaf request-registration-messages-received {
          type uint64;
          description
            "Counts the number of request_registration messages received";
        }
        leaf assign-alloc-id-messages-received {
          type uint64;
          description
            "Counts the number of assign_alloc-ID messages received";
        }
        leaf key-control-messages-received {
          type uint64;
          description
            "Counts the number of key_control messages received";
        }
        leaf sleep-allow-messages-received {
          type uint64;
          description
            "Counts the number of sleep_allow messages received";
        }
        leaf baseline-omci-messages-received-count {
          type uint64;
          description
            "Counts the number of OMCI messages received in the baseline message format";
        }
        leaf extended-omci-messages-received-count {
          type uint64;
          description
            "Counts the number of OMCI messages received in the extended message format";
        }
        leaf assign-onu-id-omci-messages-received {
          type uint64;
          description
            "Counts the number of assign_ONU-ID messages received since the last reboot";
        }
        leaf omci-mic-error-count {
          type uint64;
          description
            "Counts the number of MIC errors detected in OMCI messages directed to this ONU";
        }
      }
    }
    container PON_ONU_STATISTICS_STREAMING_ONU_XG_PON_UPSTREAM_MGMT_PM {
      description
        "PON_ONU_STATISTICS_STREAMING_ONU_XG_PON_UPSTREAM_MGMT_PM table in StateDB.";
      config false;
      list PON_ONU_STATISTICS_STREAMING_ONU_XG_PON_UPSTREAM_MGMT_PM_LIST {
        key "onu-name onu-id";
        description
          "GPON: Counters associated with upstream PLOAM and OMCI messages.
           StateDB key: PON_ONU_STATISTICS_STREAMING_ONU_XG_PON_UPSTREAM_MGMT_PM|<onu-name>|<onu-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf onu-id {
          type uint16;
          description
            "Performance management ME ID.";
        }
        leaf interval-end-time {
          type uint64;
          description
            "Identifies the most recently finished 15 min interval.";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "Points to an instance of the threshold data 1 ME that contains PM threshold values.";
        }
        leaf upstream-ploam-message-count {
          type uint64;
          description
            "Counts PLOAM messages transmitted upstream, excluding acknowledge messages";
        }
        leaf serial-number-message-count {
          type uint64;
          description
            "Counts Serial_number_ONU PLOAM messages transmitted";
        }
        leaf registration-message-count {
          type uint64;
          description
            "Counts registration PLOAM messages transmitted";
        }
        leaf key-report-message-count {
          type uint64;
          description
            "Counts key_report PLOAM messages transmitted";
        }
        leaf acknowledge-message-count {
          type uint64;
          description
            "Counts acknowledge PLOAM messages transmitted. It includes all forms of acknowledgement,
             including those transmitted in response to a PLOAMu grant when the ONU has nothing to send.
            ";
        }
        leaf sleep-request-message-count {
          type uint64;
          description
            "Counts sleep_request PLOAM messages transmitted";
        }
      }
    }
    container PON_ONU_STATISTICS_STREAMING_ONU_FEC_PM {
      description
        "PON_ONU_STATISTICS_STREAMING_ONU_FEC_PM table in StateDB.";
      config false;
      list PON_ONU_STATISTICS_STREAMING_ONU_FEC_PM_LIST {
        key "onu-name onu-id";
        description
          "GPON: FEC statistics reported by ONU through OMCI.
           StateDB key: PON_ONU_STATISTICS_STREAMING_ONU_FEC_PM|<onu-name>|<onu-id>.";
        leaf onu-name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_ONU_STATE/sp:PON_ONU_STATE_LIST/sp:onu-name";
          }
          description
            "References PON_ONU_STATE_LIST.";
        }
        leaf onu-id {
          type uint16;
          description
            "Performance management ME ID.";
        }
        leaf corrected-bytes {
          type uint64;
          description
            "corrected bytes";
        }
        leaf corrected-code-words {
          type uint64;
          description
            "corrected code words";
        }
        leaf fec-seconds {
          type uint64;
          description
            "fec seconds";
        }
        leaf interval-end-time {
          type uint64;
          description
            "interval end time";
        }
        leaf threshold-data-1-2-id {
          type omci-types:omci-uint16;
          description
            "threshold data 1/2 id";
        }
        leaf total-code-words {
          type uint64;
          description
            "total code words";
        }
        leaf uncorrectable-code-words {
          type uint64;
          description
            "uncorrectable code words";
        }
      }
    }
    container PON_FIRMWARE_FILENAME_STATE {
      description
        "PON_FIRMWARE_FILENAME_STATE table in StateDB.";
      config false;
      list PON_FIRMWARE_FILENAME_STATE_LIST {
        key "filename";
        description
          "PON_FIRMWARE_FILENAME_STATE configuration.
           StateDB key: PON_FIRMWARE_FILENAME_STATE|<filename>.";
        leaf filename {
          type string;
        }
      }
    }
    container PON_OLT_PLUG_STATE {
      description
        "PON_OLT_PLUG_STATE table in StateDB.";
      config false;
      list PON_OLT_PLUG_STATE_LIST {
        key "name";
        description
          "List of OLT plug state entries.
           StateDB key: PON_OLT_PLUG_STATE|<name>.";
        leaf name {
          type leafref {
            path "/sp:sonic-pon/sp:PON_OLT_INTF_STATE/sp:PON_OLT_INTF_STATE_LIST/sp:olt-intf-name";
          }
          description
            "References PON_OLT_INTF_STATE_LIST.";
        }
        leaf fw-bank-ptr {
          type uint16;
          description
            "Current Firmware bank pointer";
        }
        leaf fw-version {
          type string;
          description
            "The current running version of firmware";
        }
        leaf hardware-version {
          type string;
          description
            "OLT module hardware revision.";
        }
        leaf manufacturer {
          type string;
          description
            "Manufacturer of the module.";
        }
        leaf manufacturer-model {
          type string;
          description
            "Manufacturer model of the module.";
        }
        leaf manufacturer-serial-number {
          type string;
          description
            "OLT subassembly serial number.";
        }
        leaf model {
          type string;
          description
            "Manufacturer Model Name.";
        }
        leaf online-time {
          type yang:date-and-time;
          description
            "The last time the Controller successfully completed configuration of the OLT.";
        }
        leaf production-code {
          type string;
          description
            "Device production code.";
        }
        leaf serial-number {
          type string;
          description
            "The serial number for the Module. This value is assigned by the vendor of the OLT module and is often OLT-<MAC Address>.";
        }
        leaf uptime {
          type uint64;
          units "milliseconds";
          description
            "The time since the OLT module was reset.";
        }
        leaf switch-chassis-id {
          type string;
          description
            "MAC address of switch.";
        }
        leaf switch-ipv4-address {
          type string;
          description
            "IP Address of the switch.";
        }
        leaf switch-ipv6-address {
          type string;
          description
            "IP Address of the switch.";
        }
        leaf switch-port-description {
          type string;
          description
            "String description of the port";
        }
        leaf switch-port-id {
          type string;
          description
            "String identification for the port.";
        }
        leaf switch-system-description {
          type string;
          description
            "System Description.";
        }
        leaf switch-system-name {
          type string;
          description
            "Name for the Switch.";
        }
        leaf fw-upgrade-bank {
          type uint16;
          description
            "Last firmware bank number (software download ME ID) firmware was downloaded to.";
        }
        leaf fw-upgrade-fx-code {
          type uint32;
          description
            "OLT plug Software Download error code.";
        }
        leaf fw-upgrade-file {
          type string;
          description
            "Name of the file to download.";
        }
        leaf fw-upgrade-status {
          type string;
          description
            "Software download status (Downloading, Success, Failed).";
        }
        leaf fw-upgrade-duration {
          type string;
          description
            "Length of time in hours, minutes, and seconds for the OLT plug upgrade to complete.";
        }
        leaf fw-upgrade-time {
          type yang:date-and-time;
          description
            "Timestamp reporting time the OLT plug was upgraded.";
        }
        leaf hw-failure {
          type string;
          description
            "Current hardware failure status.";
        }
      }
    }
  }
}
